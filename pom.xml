<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2236.v12dd4c483242</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>job-config-chain</artifactId>
  <version>${revision}</version>
  <packaging>hpi</packaging>

  <name>Job Config Chain</name>
  <description>
    Keeps a nested structured-config token store (per common/env layer) structurally in sync with
    #{Dotted.Path}# placeholder tokens in a target application config file, validating drift and
    substituting real values at deploy time, without an external database or a git-backed store.
  </description>
  <url>https://github.com/Retro-kharkov1/job-config-chain</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>retrokharkov1</id>
      <name>Retro-kharkov1</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Retro-kharkov1/job-config-chain.git</connection>
    <developerConnection>scm:git:https://github.com/Retro-kharkov1/job-config-chain.git</developerConnection>
    <url>https://github.com/Retro-kharkov1/job-config-chain</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- CI-friendly version (https://maven.apache.org/maven-ci-friendly.html).
         IMPORTANT (verified against Maven's own docs and empirically against this repo):
         `${revision}` is interpolated into <version> while Maven builds the reactor's
         project models, BEFORE any lifecycle phase of any plugin runs — so a plugin
         execution bound to `validate`/`initialize` (e.g. exec-maven-plugin, gmavenplus)
         CANNOT set this property in time to affect this build's own packaged artifact
         version (confirmed: it still produced "0.0.0-SNAPSHOT" in the .hpi manifest
         even though the script ran and computed a real SemVer). Per Maven's own docs,
         `revision` must be present as a command-line `-D` property or via
         `.mvn/maven.config` BEFORE Maven starts reading POMs.
         That is why version computation lives in `mvnw`/`mvnw.cmd` (see repo root):
         the wrapper shells out to `dotnet-gitversion` first and passes
         `-Drevision=<computed SemVer>` into the real `mvn` invocation it wraps. This
         default value below is only the graceful-degradation fallback for a bare
         checkout with no git history / no GitVersion CLI installed (or for anyone who
         invokes the raw `mvn` binary directly instead of the wrapper). -->
    <revision>0.0.0-SNAPSHOT</revision>
    <!-- Bumped 2026-09-16 alongside the parent POM bump: the new parent
         (org.jenkins-ci.plugins:plugin 6.2236.v12dd4c483242) itself declares
         <jenkins.version>2.479</jenkins.version> as its own minimum baseline and
         <maven.compiler.release>17</maven.compiler.release> as its Java baseline -
         both strictly above this project's previous 2.426.3 / Java 11. jenkins.version
         is set to 2.555.3 (not the parent's bare minimum, and not the newest LTS
         2.568.3 either) per the official baseline-selection guidance at
         https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/,
         which names 2.541.3/2.555.3 as the currently recommended "good core
         dependencies" choices. java.level/maven.compiler.source/target are bumped to
         17 to satisfy the parent's own maven.compiler.release requirement. -->
    <jenkins.version>2.555.3</jenkins.version>
    <java.level>17</java.level>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-2.555.x</artifactId>
        <version>7046.v43536164769c</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <!-- JenkinsRule-based integration tests (ConfigTemplateSubstituteStepTest /
             ConfigTemplateValidateStepTest) each boot a full embedded Jenkins controller
             (WarExploder + a fresh $JENKINS_HOME under target/tmp) once per @Test method,
             all within one shared, non-reused surefire fork per test class (parent POM
             default: reuseForks=false, one fork *per test class*, not per method — see
             https://maven.apache.org/surefire/maven-surefire-plugin/examples/fork-options.html).
             On a slower/antivirus-scanned Windows filesystem this occasionally exposes a
             real, upstream jenkins-test-harness startup race — confirmed by reproduction in
             this repo — where a fast-starting JenkinsRule instance briefly reports a
             NoSuchFileException creating $JENKINS_HOME/users, or a not-yet-fully-registered
             Pipeline step ("No such DSL method '<step>' found"), before the reactor has
             actually finished. Both are transient JenkinsRule-bootstrap-ordering issues, not
             a defect in this plugin's Step/StepExecution/persistence code (verified by
             reading and re-running that code in isolation with a clean process table — no
             lock, no un-released resource, no missing callback was found there).
             `rerunFailingTestsCount` re-runs only tests that already failed (never a test
             that is still hanging/never completed) and is Surefire's own documented
             mechanism for exactly this "flaky, externally-caused, but not deadlocked" class
             of failure — see
             https://maven.apache.org/surefire/maven-surefire-plugin/test-mojo.html#rerunFailingTestsCount.
             It does not swallow a genuine hang (a hung fork never reaches "failed" so is
             never a rerun candidate), and it does not weaken any assertion. -->
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <rerunFailingTestsCount>2</rerunFailingTestsCount>
        </configuration>
      </plugin>
      <plugin>
        <!-- Reproduced directly in this repo (not just in the Docker build, see
             docker-build.cmd/.sh): right after a JenkinsRule-based test's forked JVM exits,
             `mvn clean`'s next invocation can fail with "Failed to delete target -> ..."
             because a native helper file JenkinsRule/JNA extracted under target/tmp is still
             transiently locked (observed: by AV real-time scanning, not by any live process —
             `tasklist` showed zero java.exe at the moment of failure). This is the same
             documented Windows-only maven-clean-plugin quirk as docker-build.*, and the same
             class of transient lock that — if hit by a *starting* JenkinsRule/WarExploder
             instead of by `clean` — can make that next test hang waiting on the lock instead
             of failing fast. `failOnError=false` only demotes one leftover-file delete
             failure to a warning; it does not skip cleaning, and it does not touch the test
             results themselves. See
             https://maven.apache.org/plugins/maven-clean-plugin/clean-mojo.html#failOnError. -->
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <failOnError>false</failOnError>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
    </dependency>
    <dependency>
      <!-- FR-95/OQ-11: SetupConfigTemplateStep's ParallelBranchGuard needs FlowNode/ThreadNameAction,
           which live in workflow-api, not workflow-cps (that stays test-scope only, deliberately —
           see the tech-lead contract review's OQ-11 §7 for why CpsThread/workflow-cps was rejected
           for this). Not pulled in transitively by workflow-step-api at any scope (confirmed by
           reading workflow-step-api-plugin's own pom.xml/StepContext.java source) — this is a new,
           real main-scope dependency, version managed by the imported bom-2.555.x. -->
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-durable-task-step</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>
    <dependency>
      <!-- StringCredentials is resolved at Pipeline Step *runtime* (ConfigTemplateSubstituteStep,
           via CredentialsProvider.findCredentialById), not just from test fixtures/e2e seed data —
           this must be a normal compile-scope dependency, not test-only. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
    </dependency>
    <dependency>
      <!-- Supplies the `symbol-*-plugin-ionicons-api` icon symbols used by
           ConfigTemplatesRootAction/ConfigTemplatesJobAction#getIconFileName(). Without this as a
           real runtime dependency the symbol cannot be resolved on a live controller and Jenkins
           renders its missing-symbol placeholder instead of the icon (owner report, 2026-09-18:
           a cross appeared on both "Config Templates" menu entries). Version is managed by the
           imported bom-2.555.x. -->
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>ionicons-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>
    <dependency>
      <!-- YAML content-type support (NFR-9). No transitive snakeyaml is pulled in by this project's
           current dependency tree (confirmed via `mvn dependency:tree -Dincludes=org.yaml:snakeyaml`
           before adding this — zero matches), so this is a fresh explicit pin, not an alignment to an
           existing transitive version. Used only via the safe, low-level Yaml#compose/Yaml#serialize
           node-graph API (YamlTreeAdapter) — never Yaml#load()'s Constructor-based POJO
           deserialization — so CVE-2022-1471's unsafe-deserialization class does not apply to this
           usage pattern; 2.2 is still picked as a modern, already-patched baseline. -->
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
    </dependency>
    <dependency>
      <!-- Standalone Nashorn (removed from the JDK itself since 15; this build runs on a newer
           JDK per maven -v). Used ONLY in test scope to compile (syntax-check, never execute)
           each admin page's rendered inline <script> blocks — a real-JS-engine regression guard
           for the class of "raw newline/HTML-entity breaks the JS string literal" bug fixed in
           ConfigSetPage#toJsScriptStringLiteral, since HtmlUnit's own embedded JS engine did not
           catch it (see ConfigTemplatesUiTest's existing notes on that limitation). -->
      <groupId>org.openjdk.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <version>15.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <!--
    GitHub Packages publishing is deliberately a PROFILE, not an unconditional
    <distributionManagement> override.

    Why: the inherited parent (org.jenkins-ci.plugins:plugin) already declares its own
    <distributionManagement> pointing at https://repo.jenkins-ci.org/{releases,snapshots}/
    (confirmed by fetching that parent pom directly, not assumed) — that is the registry
    the *official* Jenkins hosting/release path (see HOSTING.md) uses once this repo is
    forked into the jenkinsci GitHub org and released via ci.jenkins.io's own tooling and
    Jenkins-project Artifactory credentials. HOSTING.md's transfer step forks this exact
    repo history — including this pom.xml — into jenkinsci/job-config-chain-plugin, so an
    unconditional override here would silently redirect that FUTURE official release
    (running under different, jenkinsci-owned CI/credentials) at this personal GitHub
    Packages registry instead of Jenkins' own Artifactory, which is not what it expects
    and has no credentials for.

    Gating it behind this profile means a bare `mvn deploy` / `mvn release:perform` (what
    the official jenkins-infra pipeline-library's buildPlugin()/release tooling runs)
    keeps resolving distributionManagement from the parent POM exactly as before. Only
    the interim GitHub Actions publish workflow in this repo
    (.github/workflows/publish-github-packages.yaml) opts in explicitly with
    `-Pgithub-packages`.
  -->
  <profiles>
    <profile>
      <id>github-packages</id>
      <distributionManagement>
        <repository>
          <id>github</id>
          <name>GitHub Retro-kharkov1 Apache Maven Packages</name>
          <url>https://maven.pkg.github.com/Retro-kharkov1/job-config-chain</url>
        </repository>
      </distributionManagement>
    </profile>
  </profiles>
</project>
