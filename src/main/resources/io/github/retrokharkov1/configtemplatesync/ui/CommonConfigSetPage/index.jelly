<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="${it.displayName}">
    <l:main-panel>
      <st:bind var="proxy" value="${it}"/>

      <style>
        /* Scoped to this page only (never a global Jenkins button-style override) — button
           spacing polish (owner report, 2026-09-01 UI-polish pass): consistent margin on all
           sides so buttons never touch each other or the panel edge. */
        .ctsync-page .jenkins-button { margin: 4px 6px 4px 0; }
        .ctsync-page table.jenkins-table .jenkins-button { margin: 2px 4px; }
        .ctsync-section-header { margin: 12px 0 4px; }
        .ctsync-btn-row { margin: 4px 0 12px; }
        /* "Add / update secret path" — one line, not stacked (owner report item 2).
           `!important` on width is deliberate here: Jenkins core's own `.setting-input`/
           `.jenkins-select` classes set an explicit `width: 100%`, which — being a real
           `width` declaration, not just a flex-basis — wins over `flex: 1 1 ...` and forces
           each child onto its own row regardless of flex-wrap. Scoped to this page only. */
        .ctsync-secret-form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 8px 0 16px; }
        .ctsync-secret-form .ctsync-secret-path-input { flex: 1 1 240px; min-width: 180px; width: auto !important; }
        .ctsync-secret-form .jenkins-select { flex: 0 0 auto; width: auto !important; }
        .ctsync-secret-form .jenkins-select__input { width: auto !important; }
        /* Compare interaction redesign (2026-09-01, owner report) — click-a-row-to-compare,
           with no checkbox anywhere in the history table. The whole row is the click target,
           so it needs a pointer cursor and a clear "currently being compared" highlight. */
        .ctsync-history-row { cursor: pointer; }
        .ctsync-history-row:hover { background-color: var(--table-hover-color, #f0f6ff); }
        .ctsync-history-row--selected,
        .ctsync-history-row--selected:hover { background-color: var(--table-highlight-color, #d9edf7); }
        /* Button-layout convention pass (owner report, 2026-09-01): the primary/secondary save
           action pair reads as a top-of-section action group and should sit right-aligned, the
           same convention already used by this plugin's own page-level action rows (see the
           env-override page's Generate Template/Back row) — not left-aligned in the page flow. */
        .ctsync-btn-row--right { text-align: right; }
        /* A banner that pairs a status message with a single follow-up action should present the
           action on the opposite side from the message, not immediately inline after the text. */
        .ctsync-banner-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
        /* Spacing fix (owner report, 2026-09-01): the compare-banner status text was reading as
           crowded against the "Load into editor"/"Back to editing" buttons — give it its own
           breathing room from the button group on both sides of the wrap breakpoint. */
        .ctsync-banner-row > #compareBannerText { margin-right: 16px; }
        /* Layout-fidelity pass (owner report, 2026-09-01): the section heading and its primary
           save actions read as one action bar and belong on the same line, right-aligned actions
           opposite the heading — not on a separate line below it. */
        .ctsync-editor-header-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
        .ctsync-editor-header-row b { font-size: 1.1em; }
        /* Responsive stacking (owner report, 2026-09-01): below this width every wide element on
           this page stacks to a single column, and the version-history table degrades from a
           multi-column grid to a compact, labeled, one-value-per-line row per version instead of
           overflowing or requiring horizontal scroll. */
        @media (max-width: 1100px) {
          .ctsync-page .ctsync-history-table thead { display: none; }
          .ctsync-page .ctsync-history-table,
          .ctsync-page .ctsync-history-table tbody,
          .ctsync-page .ctsync-history-table tr,
          .ctsync-page .ctsync-history-table td { display: block; width: 100% !important; }
          .ctsync-page .ctsync-history-table tr { border-bottom: 1px solid var(--table-border-color, #ddd); padding: 6px 0; }
          .ctsync-page .ctsync-history-table td { padding: 2px 4px; }
          .ctsync-page .ctsync-history-table td[data-th]::before {
            content: attr(data-th) ": ";
            font-weight: 600;
            display: inline-block;
            min-width: 90px;
          }
          .ctsync-editor-header-row { justify-content: flex-start; }
          /* At this width the banner's text and button group wrap onto separate lines, so the
             right-margin gap above collapses to 0 — replace it with vertical breathing room. */
          .ctsync-banner-row > #compareBannerText { margin-right: 0; margin-bottom: 8px; display: block; }
        }
      </style>

      <div class="ctsync-page">

      <h1>${it.displayName}</h1>
      <j:if test="${!it.exists}">
        <div class="alert alert-info">This Config Set does not exist yet — Save creates it.</div>
      </j:if>

      <h2>Version history</h2>
      <p>Click a row to compare it against the editor's current draft (no checkbox required —
         click any row again to return to editing).</p>
      <table class="jenkins-table ctsync-history-table" style="width:100%">
        <thead><tr><th>Version</th><th>Created</th><th>Created by</th><th>Note</th><th>Active</th><th>Actions</th></tr></thead>
        <tbody>
          <j:forEach var="v" items="${it.versions}">
            <tr id="historyRow-${v.versionNumber}" class="ctsync-history-row"
                tabindex="0" role="button"
                onclick="selectHistoryRow(${v.versionNumber});"
                onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectHistoryRow(${v.versionNumber}); }">
              <td data-th="Version">v${v.versionNumber}</td>
              <td data-th="Created">${v.timestampEpochMillis}</td>
              <td data-th="Created by">${v.author}</td>
              <td data-th="Note">${v.note}</td>
              <td data-th="Active">
                <j:if test="${it.activeVersion != null and it.activeVersion.versionNumber == v.versionNumber}">
                  &#9679; active
                </j:if>
              </td>
              <td data-th="Actions">
                <j:choose>
                  <j:when test="${it.activeVersion != null and it.activeVersion.versionNumber == v.versionNumber}">
                    <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn"
                            disabled="disabled" data-always-disabled="true"
                            title="Already the active version">Activate</button>
                  </j:when>
                  <j:otherwise>
                    <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn"
                            title="Activate version ${v.versionNumber} without changing the editor content"
                            onclick="event.stopPropagation(); activateVersion(${v.versionNumber});">Activate</button>
                  </j:otherwise>
                </j:choose>
              </td>
            </tr>
          </j:forEach>
        </tbody>
      </table>

      <div id="saveBanner" class="alert alert-danger" style="display:none"></div>

      <div class="ctsync-section-header ctsync-editor-header-row">
        <b>Editor</b>
        <span class="ctsync-btn-row" style="margin:0">
          <button type="submit" form="ctsyncSaveForm" id="saveBtn" class="jenkins-button jenkins-button--primary"
                  title="Save the editor content as a new version">Save</button>
          <button type="submit" form="ctsyncSaveForm" id="saveActivateBtn"
                  onclick="document.getElementById('activateFlag').value='true';"
                  class="jenkins-button"
                  title="Save the editor content as a new version and immediately activate it">Save &amp; Activate</button>
        </span>
      </div>
      <div class="ctsync-btn-row">
        <button type="button" id="modeEditBtn"
               class="jenkins-button jenkins-button--primary" title="Switch to the editable JSON editor"
               onclick="switchToEditMode();">&#9998; Editing</button>
        <j:choose>
          <j:when test="${it.templateAvailable}">
            <button type="button" id="modeGenerateBtn"
                   class="jenkins-button" title="Show a copy-paste-ready tokenized template from the ACTIVE version"
                   onclick="switchToGenerateMode();">&#128203; Generate Template</button>
          </j:when>
          <j:otherwise>
            <button type="button" id="modeGenerateBtn"
                   class="jenkins-button" disabled="disabled"
                   title="no active version yet">&#128203; Generate Template</button>
          </j:otherwise>
        </j:choose>
      </div>
      <div id="compareBanner" class="alert alert-info ctsync-banner-row" style="display:none">
        <span id="compareBannerText"/>
        <span>
          <button type="button" id="loadComparedBtn" class="jenkins-button jenkins-button--primary"
                 title="Accept the version being compared into the editor as the new draft"
                 onclick="loadComparedIntoEditor();">Load into editor</button>
          <button type="button" id="backToEditingBtn" class="jenkins-button"
                 title="Discard the comparison and return to editing — the draft is left unchanged"
                 onclick="switchToEditMode();">Back to editing</button>
        </span>
      </div>
      <div id="generateBanner" class="alert alert-info" style="display:none">
        Common-only template from the ACTIVE version — NOT this box's unsaved edits, if any.
      </div>
      <div id="monacoEditor" style="height:420px;border:1px solid #ccc"/>
      <div id="generateCopyRow" style="display:none;margin-top:4px">
        <button type="button" id="copyTemplateBtn" class="jenkins-button"
                title="Copy the generated template to the clipboard"
                onclick="copyGeneratedTemplate();">&#128203; Copy to clipboard</button>
      </div>

      <form method="post" action="save" id="ctsyncSaveForm" onsubmit="return prepareSubmit();">
        <textarea name="content" id="contentField" style="display:none"/>
        <f:entry title="Change note (required)">
          <input class="setting-input" type="text" name="note" required="required"/>
        </f:entry>
        <input type="hidden" name="activate" id="activateFlag" value=""/>
      </form>

      <h2>Secrets manifest</h2>
      <p>A path listed here is structurally locked: the JSON editor above may only hold the literal
         <code>__SECRET__</code> placeholder at this path — save is rejected otherwise. The real
         value is supplied only via the Jenkins credential picked below, never typed here.</p>
      <table class="jenkins-table" style="width:60%">
        <thead><tr><th>Dotted path</th><th>Credential</th><th/></tr></thead>
        <tbody>
          <j:if test="${it.exists}">
            <j:forEach var="entry" items="${it.configSet.secretsManifest.entrySet()}">
              <tr>
                <td>${entry.key}</td>
                <td>${entry.value}</td>
                <td>
                  <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn"
                          data-secret-path="${entry.key}"
                          title="Remove this secret path binding"
                          onclick="removeSecret(this.getAttribute('data-secret-path'));">&#128465; Remove</button>
                </td>
              </tr>
            </j:forEach>
          </j:if>
        </tbody>
      </table>
      <f:entry title="Add / update secret path">
        <div class="ctsync-secret-form">
          <input class="setting-input ctsync-secret-path-input" type="text" id="secretPath" placeholder="database.password"/>
          <div class="jenkins-select">
            <select class="jenkins-select__input" id="secretCredentialId">
              <j:forEach var="cid" items="${it.availableCredentialIds}">
                <option value="${cid}">${cid}</option>
              </j:forEach>
            </select>
          </div>
          <button type="button" class="jenkins-button"
                  title="Bind the selected credential to this secret path"
                  onclick="addSecret();">Bind credential</button>
        </div>
      </f:entry>

      <script src="${rootURL}/plugin/config-template-sync/monaco/vs/loader.js"/>
      <link rel="stylesheet" href="${rootURL}/plugin/config-template-sync/monaco/vs/editor/editor.main.css"/>
      <script>
        var __seed = <j:out value="${it.editorSeedJsonForScript}"/>;
        var editor;
        var diffEditor;
        // true = "Editing" mode (normal editable Monaco editor), false = "Compare" mode (read-only
        // Monaco diff editor). Both modes render into the SAME #monacoEditor container — this is a
        // mode toggle, never a second editor instance (wireframe structural principle).
        var editMode = true;
        var lastEditContent = __seed;
        // "Generate Template" is a third mode of the SAME editor box (wireframe v2, FR-40/42) —
        // not a separate component. Tracked independently of editMode/diffEditor above.
        var generateMode = false;
        var lastGeneratedTemplateText = '';
        // Compare interaction redesign (2026-09-01): which single history version (if any) is
        // currently being diffed against the draft — click-to-select, no checkbox.
        // Re-clicking this same row exits back to edit mode (a simple selectHistoryRow toggle).
        var selectedCompareVersion = null;
        var lastComparedVersionContent = '';

        require.config({ paths: { vs: '${rootURL}/plugin/config-template-sync/monaco/vs' } });
        require(['vs/editor/editor.main'], function () {
          monaco.languages.json.jsonDefaults.setDiagnosticsOptions({
            validate: true, allowComments: false, schemas: []
          });
          editor = monaco.editor.create(document.getElementById('monacoEditor'), {
            value: __seed,
            language: 'json',
            automaticLayout: true
          });
          formatEditorContent(editor);
        });

        // Auto pretty-print JSON content whenever it's (re)loaded into the editable Monaco
        // editor, so the user never sees a minified/however-it-was-stored blob and never has to
        // trigger formatting manually. Fire-and-forget: nothing downstream depends on the
        // formatted state finishing before the user can type, and formatting is idempotent.
        function formatEditorContent(ed) {
          if (!ed) { return; }
          // Retry-until-changed, not just retry-until-the-action-object-exists: calling
          // editor.action.formatDocument right after monaco.editor.create() can silently no-op
          // (getAction() already returns a truthy action, run() resolves, but zero edits are
          // applied) while Monaco's JSON format provider/worker is still warming up — no error,
          // no console output, empirically confirmed against a real Jenkins instance. So instead
          // of trusting "the action exists" as the readiness signal, keep retrying with a short
          // backoff until the content actually changes (genuinely-already-formatted content
          // simply exhausts the retry budget harmlessly, since this is a pure display nicety).
          var attemptsLeft = 6;
          function attempt() {
            var before = ed.getValue();
            var action = ed.getAction('editor.action.formatDocument');
            if (!action) {
              if (--attemptsLeft > 0) { setTimeout(attempt, 200); }
              return;
            }
            Promise.resolve(action.run()).then(function () {
              if (ed.getValue() === before &amp;&amp; --attemptsLeft > 0) {
                setTimeout(attempt, 200);
              }
            });
          }
          setTimeout(attempt, 0);
        }

        function prepareSubmit() {
          document.getElementById('contentField').value =
              (editMode &amp;&amp; editor) ? editor.getValue() : lastEditContent;
          // FR-46: disable both save buttons for the duration of the submission — this is a
          // classic form POST, not AJAX, so the page navigates away/reloads on completion
          // regardless and there is no success path that needs to re-enable them.
          document.getElementById('saveBtn').disabled = true;
          document.getElementById('saveActivateBtn').disabled = true;
          return true;
        }

        function switchToEditMode() {
          if (editMode) { return; }
          if (diffEditor) { diffEditor.dispose(); diffEditor = null; }
          if (editor) { editor.dispose(); editor = null; }
          editor = monaco.editor.create(document.getElementById('monacoEditor'), {
            value: lastEditContent,
            language: 'json',
            automaticLayout: true
          });
          formatEditorContent(editor);
          editMode = true;
          generateMode = false;
          clearHistorySelection();
          document.getElementById('modeEditBtn').className = 'jenkins-button jenkins-button--primary';
          document.getElementById('modeGenerateBtn').className = 'jenkins-button';
          document.getElementById('compareBanner').style.display = 'none';
          document.getElementById('generateBanner').style.display = 'none';
          document.getElementById('generateCopyRow').style.display = 'none';
        }

        // Click-driven Compare (2026-09-01 redesign, owner report): no checkbox anywhere —
        // clicking an unselected version row diffs the CURRENT DRAFT against that one version;
        // re-clicking the already-selected row deselects it (back to edit mode, same as
        // `switchToEditMode`); clicking a different row while already comparing swaps the
        // right-hand pane to the newly clicked version, without ever changing the left-hand pane
        // (the draft is frozen at the moment Compare mode is entered — the plain editor is
        // swapped out for the read-only diff editor, so there is no live typing to reflect while
        // comparing anyway).
        function selectHistoryRow(version) {
          if (selectedCompareVersion === version) {
            switchToEditMode();
            return;
          }
          // JS-proxy args are sent as a single JSON-string payload, not a positional int arg — see
          // ConfigSetPage#doActivate's javadoc for why (this Stapler version's JS-proxy dispatcher
          // was empirically found to only reliably bind a single String-JSON parameter).
          proxy.compareVersions(JSON.stringify({ version: version }), function (t) {
            var r = t.responseObject();
            if (!r.ok) {
              alert(r.error);
              return;
            }
            enterCompareMode(version, r.content);
          });
        }

        function enterCompareMode(version, versionContent) {
          if (editor) {
            lastEditContent = editor.getValue();
            editor.dispose();
            editor = null;
          }
          if (diffEditor) {
            diffEditor.dispose();
            diffEditor = null;
          }
          var draftModel = monaco.editor.createModel(lastEditContent, 'json');
          var versionModel = monaco.editor.createModel(versionContent, 'json');
          diffEditor = monaco.editor.createDiffEditor(document.getElementById('monacoEditor'), {
            readOnly: true,
            automaticLayout: true,
            renderSideBySide: true
          });
          diffEditor.setModel({ original: draftModel, modified: versionModel });
          editMode = false;
          generateMode = false;
          selectedCompareVersion = version;
          lastComparedVersionContent = versionContent;
          highlightSelectedHistoryRow(version);
          document.getElementById('modeEditBtn').className = 'jenkins-button';
          document.getElementById('modeGenerateBtn').className = 'jenkins-button';
          document.getElementById('compareBannerText').textContent =
              'Comparing the current (unsaved) draft against v' + version + '.';
          document.getElementById('compareBanner').style.display = 'block';
          document.getElementById('generateBanner').style.display = 'none';
          document.getElementById('generateCopyRow').style.display = 'none';
        }

        // Accepts the version currently being compared into the draft and returns to edit mode.
        function loadComparedIntoEditor() {
          if (!selectedCompareVersion) { return; }
          lastEditContent = lastComparedVersionContent;
          switchToEditMode();
        }

        function highlightSelectedHistoryRow(version) {
          clearHistoryHighlightOnly();
          var row = document.getElementById('historyRow-' + version);
          if (row) { row.className = 'ctsync-history-row ctsync-history-row--selected'; }
        }

        function clearHistoryHighlightOnly() {
          var rows = document.querySelectorAll('.ctsync-history-row--selected');
          for (var i = 0; i &lt; rows.length; i++) {
            rows[i].className = 'ctsync-history-row';
          }
        }

        function clearHistorySelection() {
          selectedCompareVersion = null;
          lastComparedVersionContent = '';
          clearHistoryHighlightOnly();
        }

        // FR-40/42/44: swaps the SAME editor box into a read-only Monaco instance seeded with the
        // walked-and-tokenized ACTIVE version content. Zero-argument proxy.generateTemplate() call
        // (server-side signature has no overlayJson/contentJson parameter at all — FR-16) so there
        // is structurally no way this can read an unsaved draft.
        function switchToGenerateMode() {
          proxy.generateTemplate(function (t) {
            var r = t.responseObject();
            if (!r.ok) {
              alert(r.error);
              return;
            }
            if (editor) { lastEditContent = editor.getValue(); editor.dispose(); editor = null; }
            if (diffEditor) { diffEditor.dispose(); diffEditor = null; }
            lastGeneratedTemplateText = JSON.stringify(r.template, null, 2);
            editor = monaco.editor.create(document.getElementById('monacoEditor'), {
              value: lastGeneratedTemplateText,
              language: 'json',
              readOnly: true,
              automaticLayout: true
            });
            formatEditorContent(editor);
            editMode = false;
            generateMode = true;
            clearHistorySelection();
            document.getElementById('modeEditBtn').className = 'jenkins-button';
            document.getElementById('modeGenerateBtn').className = 'jenkins-button jenkins-button--primary';
            document.getElementById('compareBanner').style.display = 'none';
            document.getElementById('generateBanner').style.display = 'block';
            document.getElementById('generateCopyRow').style.display = 'block';
          });
        }

        // FR-42: standard browser Clipboard API, copies the exact editor text verbatim — no added
        // marker/comment on secret-bound lines (JSON has no comment syntax; any marker would break
        // paste-ready validity).
        function copyGeneratedTemplate() {
          var text = (generateMode &amp;&amp; editor) ? editor.getValue() : lastGeneratedTemplateText;
          navigator.clipboard.writeText(text);
        }

        // FR-46: only one activate call may be in flight at a time for this Config Set — disable
        // EVERY Activate button (not just the one clicked) before the call, and re-enable them all
        // on failure (success reloads the page, so there's nothing to re-enable in that path).
        function setActivateButtonsDisabled(disabled) {
          var buttons = document.querySelectorAll('.ctsync-activate-btn');
          for (var i = 0; i &lt; buttons.length; i++) {
            // FR-47: the already-active row's button is permanently disabled — never re-enable it
            // as a side effect of the busy-toggle finishing.
            if (buttons[i].getAttribute('data-always-disabled') === 'true') { continue; }
            buttons[i].disabled = disabled;
          }
        }

        function activateVersion(v) {
          setActivateButtonsDisabled(true);
          // See compareVersions' comment above: single JSON-string payload, not a plain int arg.
          proxy.activate(JSON.stringify({ version: v }), function (t) {
            var r = t.responseObject();
            if (r.ok) {
              location.reload();
            } else {
              setActivateButtonsDisabled(false);
              alert(r.error);
            }
          });
        }

        function addSecret() {
          var path = document.getElementById('secretPath').value;
          var cred = document.getElementById('secretCredentialId').value;
          proxy.addSecret(JSON.stringify({ path: path, credentialId: cred }), function (t) {
            var r = t.responseObject();
            if (r.ok) { location.reload(); } else { alert(r.error); }
          });
        }

        // OQ-1 CRUD completion: unbind a previously-registered secret path. Reloads the page on
        // success (same after-action shape as addSecret above) so the manifest table reflects the
        // removal without a stale row lingering client-side.
        function removeSecret(path) {
          proxy.removeSecret(JSON.stringify({ path: path }), function (t) {
            var r = t.responseObject();
            if (r.ok) { location.reload(); } else { alert(r.error); }
          });
        }
      </script>

      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
