<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <j:choose>
    <!-- FR-77: a job with no association must still render something actionable here rather than
         silently editing whichever Config Set the URL happened to name. -->
    <j:when test="${empty(it.projectKey)}">
      <l:layout title="${it.environment} — Config Templates">
        <l:main-panel>
          <h1>${it.environment}</h1>
          <p>${%noAssociation}</p>
          <p><a href="../">&#8592; ${%backToJobPage}</a></p>
        </l:main-panel>
      </l:layout>
    </j:when>
    <j:otherwise>
      <style>
        .ctsync-job-banner { border: 1px solid var(--table-border-color, #ddd); border-radius: var(--form-input-border-radius, 6px); padding: 10px 14px; margin: 0 0 20px; }
      </style>
      <!-- FR-77a: this renders the SAME EnvConfigSetPage object the global URL renders, not a
           job-scoped copy of the editor. One save path, one validation path, one persisted entity —
           guaranteed by construction, not by convention. -->
      <div class="ctsync-job-banner">

        <b>${it.projectKey} / ${it.environment}</b> — ${%openedFromJob(it.job.displayName)}<br/>

        ${%sameConfigSet} <a href="${it.canonicalUrl}">${it.canonicalUrl}</a>

      </div>

      <st:include page="index.jelly" it="${it.delegate}" from="${it.delegate}"/>
    </j:otherwise>
  </j:choose>
</j:jelly>
