<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="${it.displayName}">
    <l:main-panel>
      <st:bind var="proxy" value="${it}"/>

      <style>
        /* Scoped to this page only (never a global Jenkins button-style override) — button
           spacing polish (owner report, 2026-09-01 UI-polish pass): consistent margin on all
           sides so buttons never touch each other or the panel edge. */
        .ctsync-page .jenkins-button { margin: 4px 6px 4px 0; }
        .ctsync-page table.jenkins-table .jenkins-button { margin: 2px 4px; }
        .ctsync-section-header { margin: 12px 0 4px; }
        .ctsync-btn-row { margin: 4px 0 12px; }
        /* "Add / update secret path" — one line, not stacked (owner report item 2).
           `!important` on width is deliberate here: Jenkins core's own `.setting-input`/
           `.jenkins-select` classes set an explicit `width: 100%`, which — being a real
           `width` declaration, not just a flex-basis — wins over `flex: 1 1 ...` and forces
           each child onto its own row regardless of flex-wrap. Scoped to this page only. */
        .ctsync-secret-form { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 8px 0 16px; }
        .ctsync-secret-form .ctsync-secret-path-input { flex: 1 1 240px; min-width: 180px; width: auto !important; }
        .ctsync-secret-form .jenkins-select { flex: 0 0 auto; width: auto !important; }
        .ctsync-secret-form .jenkins-select__input { width: auto !important; }
        /* Compare interaction redesign (2026-09-01, owner report) — click-a-row-to-compare,
           with no checkbox anywhere in the history table. The whole row is the click target,
           so it needs a pointer cursor and a clear "currently being compared" highlight. */
        .ctsync-history-row { cursor: pointer; }
        .ctsync-history-row:hover { background-color: var(--table-hover-color, #f0f6ff); }
        .ctsync-history-row--selected,
        .ctsync-history-row--selected:hover { background-color: var(--table-highlight-color, #d9edf7); }
        /* Button-layout convention pass (owner report, 2026-09-01): the primary/secondary save
           action pair reads as a top-of-section action group and should sit right-aligned, the
           same convention already used by this page's own Generate Template/Back row above —
           not left-aligned in the page flow. */
        .ctsync-btn-row--right { text-align: right; }
        /* A banner that pairs a status message with a single follow-up action should present the
           action on the opposite side from the message, not immediately inline after the text. */
        .ctsync-banner-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
        /* Spacing fix (owner report, 2026-09-01): the compare-banner status text was reading as
           crowded against the "Load into editor"/"Back to editing" buttons — give it its own
           breathing room from the button group on both sides of the wrap breakpoint. */
        .ctsync-banner-row > #compareBannerText { margin-right: 16px; }
        /* Layout-fidelity pass (owner report, 2026-09-01): the "Env override" panel heading and
           its primary save actions read as one action bar and belong on the same line,
           right-aligned actions opposite the heading — not on a separate line below it. */
        .ctsync-editor-header-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
        .ctsync-editor-header-row h3 { margin: 0; }
        /* Responsive stacking (owner report, 2026-09-01): below this width the 3-panel merge
           table stacks to a single column, preserving panel order (Global, Env override, Merged
           result), and the version-history table degrades to a compact, labeled, one-value-per
           -line row per version instead of overflowing or requiring horizontal scroll. */
        /* Three-pane layout (FR-73): Merged bases / Env override on top, Merged result full-width
           below. Desktop: two columns on top; below the existing 1100px breakpoint all three panes
           stack in the same order (2-then-1 collapses directly to 3-stacked, no intermediate state). */
        .ctsync-merge-top { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .ctsync-merge-full { margin-top: 12px; }
        @media (max-width: 1100px) {
          .ctsync-merge-top { grid-template-columns: 1fr; }
          .ctsync-page .ctsync-history-table thead { display: none; }
          .ctsync-page .ctsync-history-table,
          .ctsync-page .ctsync-history-table tbody,
          .ctsync-page .ctsync-history-table tr,
          .ctsync-page .ctsync-history-table td { display: block; width: 100% !important; }
          .ctsync-page .ctsync-history-table tr { border-bottom: 1px solid var(--table-border-color, #ddd); padding: 6px 0; }
          .ctsync-page .ctsync-history-table td { padding: 2px 4px; }
          .ctsync-page .ctsync-history-table td[data-th]::before {
            content: attr(data-th) ": ";
            font-weight: 600;
            display: inline-block;
            min-width: 90px;
          }
          .ctsync-editor-header-row { justify-content: flex-start; }
          /* At this width the banner's text and button group wrap onto separate lines, so the
             right-margin gap above collapses to 0 — replace it with vertical breathing room. */
          .ctsync-banner-row > #compareBannerText { margin-right: 0; margin-bottom: 8px; display: block; }
        }
        /* Accordion layout (owner-approved plan, 2026-09-02): Secrets manifest / Env override
           version history / Editor are now independently collapsible details sections rather
           than one long always-expanded scroll. Style the summary element to read as a natural
           evolution of the existing h2 section-heading language, not a jarring new widget. */
        .ctsync-page summary { font-size: 1.4em; font-weight: 600; margin: 12px 0 4px; cursor: pointer; }
        .ctsync-page details { margin-bottom: 8px; }
        /* Table-scroll behavior (same plan): contain a long Version-history/Secrets-manifest
           table's growth so page buttons/sections below it stay reachable, without requiring the
           whole page to scroll. Applied to the wrapper div, never the table element itself —
           overflow on a table element directly has known sticky-header/border quirks. */
        .ctsync-scroll-table { max-height: 50vh; overflow-y: auto; }
        /* Base-chain editor (FR-51/FR-55/FR-56/FR-57/FR-71, wireframe Page 2). */
        .ctsync-basechain-table { width: 100%; margin-bottom: 8px; }
        .ctsync-basechain-table th, .ctsync-basechain-table td { padding: 4px 6px; text-align: left; }
        .ctsync-basechain-row select, .ctsync-basechain-row input[type="radio"] { vertical-align: middle; }
        .ctsync-basechain-reorder-btn, .ctsync-basechain-remove-btn { min-width: 28px; }
        .ctsync-basechain-row-toggle { text-decoration: none; }
        .ctsync-basechain-resolved-pre { max-height: 220px; overflow: auto; background: #f6f6f6; padding: 6px; }
        .ctsync-basechain-resolved-caption { font-size: 0.9em; color: #555; margin-bottom: 4px; }
        .ctsync-basechain-history-detail { margin-top: 4px; padding-left: 16px; font-size: 0.9em; }
        /* FR-89: explicitlyStandalone checkbox — mutually exclusive with the row table below it. */
        .ctsync-standalone-row { margin: 8px 0; }
        .ctsync-standalone-badge { font-weight: 600; }
        #baseChainEditor.ctsync-standalone-active #baseChainRowsTable { opacity: 0.5; pointer-events: none; }
        @media (max-width: 480px) {
          .ctsync-basechain-table, .ctsync-basechain-table tbody, .ctsync-basechain-table tr,
          .ctsync-basechain-table td { display: block; width: 100% !important; }
          .ctsync-basechain-row { border-bottom: 1px solid var(--table-border-color, #ddd); padding: 6px 0; }
        }
      </style>

      <div class="ctsync-page">

      <h1>${it.displayName}</h1>
      <j:if test="${!it.exists}">
        <div class="alert alert-info">${%notExistYet}</div>
      </j:if>

      <details id="secretsManifestDetails">
        <summary>${%secretsManifest.heading}</summary>
        <p>A path listed here is structurally locked: the JSON editor below may only hold the literal
           <code>__SECRET__</code> placeholder at this path — save is rejected otherwise. The real
           value is supplied only via the Jenkins credential picked below, never typed here. This
           manifest is independent of the paired Common Config Set's manifest — env overrides declare
           their own secret paths.</p>
        <div class="ctsync-scroll-table">
          <table class="jenkins-table" style="width:60%">
            <thead><tr><th>${%column.dottedPath}</th><th>${%column.credential}</th><th/></tr></thead>
            <tbody id="secretsManifestTbody">
              <j:if test="${it.exists}">
                <j:forEach var="entry" items="${it.configSet.secretsManifest.entrySet()}">
                  <tr>
                    <td>${entry.key}</td>
                    <td>${entry.value}</td>
                    <td>
                      <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn"
                              data-secret-path="${entry.key}"
                              title="${%removeSecret.title}"
                              onclick="removeSecret(this.getAttribute('data-secret-path'));">&#128465; ${%removeSecret.label}</button>
                    </td>
                  </tr>
                </j:forEach>
              </j:if>
            </tbody>
          </table>
        </div>
        <!-- In-place-update template (2026-09-02): see CommonConfigSetPage/index.jelly's identical
             template for the full rationale — addSecret/removeSecret re-render this tbody from JSON
             instead of location.reload()-ing the whole page. -->
        <template id="secretRowTemplate" data-remove-title="${%removeSecret.title}">
          <tr>
            <td class="js-secret-path"/>
            <td class="js-secret-cred"/>
            <td>
              <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn">
                &#128465; ${%removeSecret.label}</button>
            </td>
          </tr>
        </template>
        <f:entry title="${%addSecret.entryTitle}">
          <div class="ctsync-secret-form">
            <input class="setting-input ctsync-secret-path-input" type="text" id="secretPath" placeholder="database.password"/>
            <div class="jenkins-select">
              <select class="jenkins-select__input" id="secretCredentialId">
                <j:forEach var="cid" items="${it.availableCredentialIds}">
                  <option value="${cid}">${cid}</option>
                </j:forEach>
              </select>
            </div>
            <button type="button" class="jenkins-button"
                    title="${%bindCredential.title}"
                    onclick="addSecret();">${%bindCredential.label}</button>
          </div>
        </f:entry>
      </details>

      <details id="versionHistoryDetails">
        <summary>${%versionHistory.heading}</summary>
        <p>Click a row to compare it against the Env-override editor's current draft (no checkbox
           required — click any row again to return to editing).</p>
        <div class="ctsync-scroll-table">
          <table class="jenkins-table ctsync-history-table" style="width:100%">
            <thead><tr><th>${%column.version}</th><th>${%column.created}</th><th>${%column.createdBy}</th><th>${%column.note}</th><th>${%column.baseChain}</th><th>${%column.active}</th><th>${%column.actions}</th></tr></thead>
            <tbody id="versionHistoryTbody">
              <j:forEach var="v" items="${it.versions}">
                <tr id="historyRow-${v.versionNumber}" class="ctsync-history-row"
                    tabindex="0" role="button"
                    onclick="selectHistoryRow(${v.versionNumber});"
                    onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectHistoryRow(${v.versionNumber}); }">
                  <td data-th="${%column.version}">v${v.versionNumber}</td>
                  <td data-th="${%column.created}">${v.timestampEpochMillis}</td>
                  <td data-th="${%column.createdBy}">${v.author}</td>
                  <td data-th="${%column.note}">${v.note}</td>
                  <td data-th="${%column.baseChain}">
                    <!-- FR-58: each historical version's own FROZEN baseChain is already available
                         server-side at render time — no AJAX call needed to show it. FR-89: a
                         version saved as explicitlyStandalone renders a badge INSTEAD OF the
                         N-bases link, since it would otherwise be visually indistinguishable from
                         "0 bases" via any other route. -->
                    <j:choose>
                      <j:when test="${v.explicitlyStandalone}">
                        <span class="ctsync-standalone-badge" title="Declared zero base configs on purpose (FR-86/87)">
                          &#9873; Standalone
                        </span>
                      </j:when>
                      <j:otherwise>
                        <a href="#" class="ctsync-basechain-toggle"
                           onclick="event.stopPropagation(); event.preventDefault(); toggleBaseChainDetail(${v.versionNumber});">
                          &#9656; ${v.baseChain.size()} bases
                        </a>
                        <div id="baseChainDetail-${v.versionNumber}" class="ctsync-basechain-history-detail" style="display:none">
                          <j:choose>
                            <j:when test="${v.baseChain.isEmpty()}">
                              <div>(no declared chain — resolves to this env's own project, ACTIVE)</div>
                            </j:when>
                            <j:otherwise>
                              <j:forEach var="ref" items="${v.baseChain}">
                                <div>
                                  ${ref.projectKey} &#8212; ${ref.pinMode}
                                  <j:if test="${ref.pinMode == 'PINNED'}">(v${ref.pinnedVersionNumber})</j:if>
                                </div>
                              </j:forEach>
                            </j:otherwise>
                          </j:choose>
                        </div>
                      </j:otherwise>
                    </j:choose>
                  </td>
                  <td data-th="${%column.active}">
                    <j:if test="${it.activeVersion != null and it.activeVersion.versionNumber == v.versionNumber}">
                      &#9679; ${%activeStatus}
                    </j:if>
                  </td>
                  <td data-th="${%column.actions}">
                    <j:choose>
                      <j:when test="${it.activeVersion != null and it.activeVersion.versionNumber == v.versionNumber}">
                        <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn"
                                disabled="disabled" data-always-disabled="true"
                                title="${%activate.alreadyActiveTitle}">${%activate.label}</button>
                      </j:when>
                      <j:otherwise>
                        <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn"
                                title="Activate version ${v.versionNumber} without changing the editor content"
                                onclick="event.stopPropagation(); activateVersion(${v.versionNumber});">${%activate.label}</button>
                      </j:otherwise>
                    </j:choose>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </div>
        <!-- In-place-update template (2026-09-02): jsSave/activateVersion's AJAX responses re-render
             this tbody client-side from JSON instead of location.reload()-ing the whole page — see
             renderVersionHistoryRows/buildHistoryRowElement below. Static localized label/title text
             is stashed on this template (rendered once by Jelly); the per-version base-chain detail
             lines (project/pinMode/pinnedVersion — never localized even in the server-rendered
             original above) are built directly in JS from the versions payload's baseChain array. -->
        <template id="historyRowTemplate"
                  data-active-label="${%activeStatus}"
                  data-already-active-title="${%activate.alreadyActiveTitle}">
          <tr class="ctsync-history-row" tabindex="0" role="button">
            <td data-th="${%column.version}" class="js-version"/>
            <td data-th="${%column.created}" class="js-created"/>
            <td data-th="${%column.createdBy}" class="js-createdBy"/>
            <td data-th="${%column.note}" class="js-note"/>
            <td data-th="${%column.baseChain}">
              <span class="ctsync-standalone-badge js-standalone-badge" style="display:none"
                    title="Declared zero base configs on purpose (FR-86/87)">&#9873; Standalone</span>
              <a href="#" class="ctsync-basechain-toggle js-basechain-toggle">
                &#9656; <span class="js-basechain-count"/> bases</a>
              <div class="ctsync-basechain-history-detail js-basechain-detail" style="display:none"/>
            </td>
            <td data-th="${%column.active}" class="js-activeBadge"/>
            <td data-th="${%column.actions}">
              <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn js-activate-btn">
                ${%activate.label}</button>
            </td>
          </tr>
        </template>
      </details>

      <details id="editorDetails" open="open">
        <summary>${%editor.heading}</summary>

        <!-- FR-41/44: page-level action, deliberately NOT a 4th mode of the Env-override panel's own
             [Editing]/[Compare] row — see wireframe-layout.md's reasoning note. Clicking it temporarily
             replaces the whole 3-panel table below with one full-width read-only panel. -->
        <div class="ctsync-btn-row" style="text-align:right">
          <j:choose>
            <j:when test="${it.templateAvailable}">
              <button type="button" id="generateTemplateBtn" class="jenkins-button"
                     title="${%generateTemplate.title}"
                     onclick="showGeneratedTemplateView();">&#128203; ${%generateTemplate.label}</button>
            </j:when>
            <j:otherwise>
              <button type="button" id="generateTemplateBtn" class="jenkins-button" disabled="disabled"
                     title="${%generateTemplate.disabledTitle}">&#128203; ${%generateTemplate.label}</button>
            </j:otherwise>
          </j:choose>
          <button type="button" id="backTo3PanelBtn" class="jenkins-button" style="display:none"
                 title="${%backTo3Panel.title}"
                 onclick="backTo3PanelView();">&#8592; ${%backTo3Panel.label}</button>
        </div>

        <div id="generateBanner" class="alert alert-info" style="display:none">
          Effective template from <code>${it.projectKey}-common</code> ACTIVE ⊕ <code>${it.displayName}</code>
          ACTIVE — NOT the Env-override panel's in-progress unsaved edits.
        </div>

        <div id="generatedTemplatePanel" style="display:none">
          <h3>Generated template (read-only)</h3>
          <div id="generatedTemplateEditor" style="height:420px;border:1px solid #ccc"/>
          <div style="margin-top:4px">
            <button type="button" id="copyTemplateBtn" class="jenkins-button"
                    title="${%copyTemplate.title}"
                    onclick="copyGeneratedTemplate();">&#128203; ${%copyTemplate.label}</button>
          </div>
        </div>

        <div id="baseChainEditor">
          <h3>${%baseChain.heading}</h3>
          <p>Ordered list of base Config Sets folded left-to-right before this env's own overlay is
             applied — later rows win on overlapping keys. Each row either always tracks its
             project's currently-ACTIVE version, or pins to one specific historical version. Click a
             row's &#9656; to expand its resolved (read-only) content.</p>
          <!-- FR-89: mutually exclusive with having any base-chain rows — checking this clears the
               chain, greys out (never hides) the row table below, and disables Add base. -->
          <div class="ctsync-standalone-row">
            <label>
              <input type="checkbox" id="explicitlyStandaloneCheckbox"
                     onchange="onExplicitlyStandaloneChange(this.checked);"/>
              ${%explicitlyStandalone.label}
            </label>
          </div>
          <table class="jenkins-table ctsync-basechain-table" id="baseChainRowsTable">
            <thead><tr><th/><th>#</th><th>Project</th><th>Mode</th><th>Pinned version</th><th/></tr></thead>
            <tbody id="baseChainRowsBody"/>
          </table>
          <div class="ctsync-btn-row">
            <button type="button" id="addBaseChainRowBtn" class="jenkins-button"
                    title="${%addBase.title}"
                    onclick="addBaseChainRow();">&#10133; ${%addBase.label}</button>
          </div>
        </div>

        <div id="mergeLayout" class="ctsync-merge-grid">
          <div class="ctsync-merge-top">
            <div class="ctsync-merge-pane" id="mergedBasesPane">
              <h3>${%mergedBases.heading}</h3>
              <div id="mergedBasesEditor" style="height:340px;border:1px solid #ccc"/>
            </div>
            <div class="ctsync-merge-pane" id="envOverridePane">
              <div class="ctsync-editor-header-row">
                <h3>${%envOverride.heading}</h3>
              </div>
              <div class="ctsync-btn-row">
                <button type="button" id="modeEditBtn"
                       class="jenkins-button jenkins-button--primary" title="${%modeEdit.title}"
                       onclick="switchToEditMode();">&#9998; ${%modeEdit.label}</button>
                <!-- FR-60/FR-63: no picker here (an ENV Config Set's language is always resolved from
                     its base chain, never chosen) — only the YAML debounce's small non-blocking
                     indicator, same placement convention as the Global page's own row. -->
                <span id="checkingIndicator" style="display:none;color:#666;margin-left:12px">&#8987; Checking YAML&#8230;</span>
              </div>
              <!-- In-place update (2026-09-02): this env page previously had no save-feedback banner
                   at all (a classic form POST + redirect needed none) — now that Save/Save &amp;
                   Activate are AJAX, saveClicked() surfaces both success and error here, same div/
                   convention as CommonConfigSetPage's saveBanner. -->
              <div id="saveBanner" class="alert alert-danger" style="display:none"/>
              <div id="compareBanner" class="alert alert-info ctsync-banner-row" style="display:none">
                <span id="compareBannerText"/>
                <span>
                  <button type="button" id="loadComparedBtn" class="jenkins-button jenkins-button--primary"
                         title="${%loadIntoEditor.title}"
                         onclick="loadComparedIntoEditor();">${%loadIntoEditor.label}</button>
                  <button type="button" id="backToEditingBtn" class="jenkins-button"
                         title="${%backToEditing.title}"
                         onclick="switchToEditMode();">${%backToEditing.label}</button>
                </span>
              </div>
              <div id="overrideEditor" style="height:380px;border:1px solid #ccc"/>
            </div>
          </div>
          <div class="ctsync-merge-pane ctsync-merge-full" id="mergedResultPane">
            <h3>${%mergedResult.heading}</h3>
            <div id="mergedEditor" style="height:380px;border:1px solid #ccc"/>
            <div id="mergedStaleIndicator" style="display:none;color:#a33">
              showing last valid merge — override JSON is currently invalid
            </div>
          </div>
        </div>

        <!-- No longer a &lt;form&gt; (2026-09-02 in-place-update pass): Save/Save &amp; Activate now
             call proxy.save(...) directly from saveClicked() below — content comes straight from
             the live Env-override Monaco editor, never a hidden textarea; there is no native submit
             to prepare. The note input and baseChainField remain plain elements JS reads by id
             (baseChainField is also kept in sync by recomputeMerge/renderBaseChainRows, unrelated to
             saving). -->
        <f:entry title="${%changeNote.entryTitle}">
          <input class="setting-input" type="text" id="noteField" required="required"/>
        </f:entry>
        <input type="hidden" id="baseChainField" value=""/>

        <!-- Bottom-of-form position (owner request, 2026-09-02 UI reorg): Save/Save &amp; Activate
             relocated below the change-note field — the natural end-of-form position — instead of
             sitting inline with the "Env override" panel heading. -->
        <div class="ctsync-btn-row">
          <button type="button" id="saveBtn" class="jenkins-button jenkins-button--primary"
                  title="${%save.title}" onclick="saveClicked(false);">${%save.label}</button>
          <button type="button" id="saveActivateBtn"
                  class="jenkins-button"
                  title="${%saveActivate.title}" onclick="saveClicked(true);">${%saveActivate.label}</button>
          <!-- FR-74: presented alongside Save/Save &amp; Activate — pure client-side revert, no new
               server endpoint. -->
          <button type="button" id="discardAllBtn" class="jenkins-button jenkins-button--destructive"
                  title="${%discardAll.title}" onclick="discardAllChangesClicked();">${%discardAll.label}</button>
        </div>
      </details>

      <script src="${rootURL}/plugin/config-template-sync/monaco/vs/loader.js"/>
      <link rel="stylesheet" href="${rootURL}/plugin/config-template-sync/monaco/vs/editor/editor.main.css"/>
      <script>
        var __overrideSeed = <j:out value="${it.editorSeedJsonForScript}"/>;
        var __availableProjectKeys = <j:out value="${it.availableCommonProjectKeysJsonForScript}"/>;
        var __baseChainSeed = <j:out value="${it.baseChainSeedJsonForScript}"/>;
        var __commonVersionCatalog = <j:out value="${it.commonVersionCatalogJsonForScript}"/>;
        var overrideEditor, mergedEditor, mergedBasesEditor, debounceHandle, diffEditor;
        // FR-41/42/44: the generated-template full-width panel is a separate Monaco instance from
        // the merge layout's own editors (never a 4th mode of the override panel — see the
        // page-level button's placement comment above), shown/hidden by toggling #mergeLayout
        // vs. #generatedTemplatePanel.
        var generatedTemplateEditor;
        var lastGeneratedTemplateText = '';
        // Same structural principle as the Global edit page: Compare is a mode toggle on the
        // Env-override editor region (#overrideEditor), never a second editor.
        var editMode = true;
        var lastEditContent = __overrideSeed;
        // Compare interaction redesign (2026-09-01): which single history version (if any) is
        // currently being diffed against the Env-override draft — click-to-select, no checkbox.
        // Re-clicking this same row exits back to edit mode.
        var selectedCompareVersion = null;
        var lastComparedVersionContent = '';

        // Base-chain editor draft state (FR-51/FR-55/FR-71): an ordered array of
        // { projectKey, pinMode: 'ACTIVE'|'PINNED', pinnedVersionNumber } rows, seeded from
        // __baseChainSeed (FR-56: exactly one default row for a brand-new env Config Set) and kept
        // in sync with the rendered #baseChainRowsBody tbody on every add/remove/reorder/
        // project-change/mode-change/pin-version-change. baseChainRowExpanded is a parallel
        // boolean[] tracking each row's accordion expand state, kept in lockstep with
        // baseChainRows on add/remove/reorder — expand state is a pure UI concern, never part of
        // the serialized baseChainJson payload.
        var availableProjectKeys = JSON.parse(__availableProjectKeys);
        var commonVersionCatalog = JSON.parse(__commonVersionCatalog);
        var baseChainRows = JSON.parse(__baseChainSeed);
        var baseChainRowExpanded = baseChainRows.map(function () { return false; });
        var lastPerReference = [];
        // FR-89: mirrors the explicitlyStandaloneCheckbox's live state — kept in sync by
        // onExplicitlyStandaloneChange, threaded into previewMerge so the live "Merged bases"/
        // "Merged result" panels can represent a genuinely-empty chain while mid-edit (FR-87),
        // instead of previewMergeImpl silently substituting the FR-52 synthesized default.
        var explicitlyStandalone = ${it.explicitlyStandaloneSeed};
        // FR-74: "last saved" baseline — refreshed on every successful save (saveClicked's success
        // branch below), NOT just at page-load time, since saves are already in-place AJAX with no
        // page reload; discardAllChangesClicked reverts to these, not the original page-load seeds.
        var lastSavedOverrideContent = __overrideSeed;
        var lastSavedBaseChainJson = __baseChainSeed;
        var lastSavedExplicitlyStandalone = explicitlyStandalone;
        // FR-60: an ENV Config Set has no own content-type picker — its language mode always
        // follows the resolved base chain's shared ContentType, updated on every recomputeMerge
        // response (default JSON until the first resolve lands).
        var currentContentType = 'JSON';
        var yamlCheckTimer = null;

        // FR-63/FR-64: JSON/XML/YAML all dispatch through this one language-mode lookup — no
        // per-format special-casing anywhere else in this script beyond it (mirrors the Global
        // page's identical helper).
        function languageForType(type) {
          if (type === 'XML') { return 'xml'; }
          if (type === 'YAML') { return 'yaml'; }
          return 'json';
        }

        // FR-64: XML/YAML "Format document" round-trips doFormatContent — JSON keeps Monaco's own
        // built-in formatter (unchanged), so no provider is registered for it here.
        function registerXmlYamlFormatProviders() {
          ['xml', 'yaml'].forEach(function (lang) {
            monaco.languages.registerDocumentFormattingEditProvider(lang, {
              provideDocumentFormattingEdits: function (model) {
                return new Promise(function (resolve) {
                  var type = lang === 'xml' ? 'XML' : 'YAML';
                  proxy.formatContent(JSON.stringify({ content: model.getValue(), contentType: type }), function (t) {
                    var r = t.responseObject();
                    if (!r.ok) { resolve([]); return; }
                    resolve([{ range: model.getFullModelRange(), text: r.formatted }]);
                  });
                });
              }
            });
          });
        }

        // FR-63: XML gets synchronous, client-side DOMParser diagnostics; YAML gets a debounced
        // server round trip (doValidateContent) with the small non-blocking "Checking YAML…"
        // indicator, shown directly above the Env-override panel only (not Effective base/Merged
        // result, already covered by the existing stale-indicator convention); JSON keeps Monaco's
        // built-in JSON diagnostics, so this function is a no-op for JSON.
        function runXmlDiagnostics(ed) {
          var markers = [];
          try {
            var doc = new DOMParser().parseFromString(ed.getValue(), 'application/xml');
            var errorNode = doc.getElementsByTagName('parsererror')[0];
            if (errorNode) {
              markers.push({
                severity: monaco.MarkerSeverity.Error,
                message: errorNode.textContent || 'Malformed XML',
                startLineNumber: 1, startColumn: 1, endLineNumber: 1, endColumn: 1
              });
            }
          } catch (e) {
            markers.push({
              severity: monaco.MarkerSeverity.Error,
              message: String(e),
              startLineNumber: 1, startColumn: 1, endLineNumber: 1, endColumn: 1
            });
          }
          monaco.editor.setModelMarkers(ed.getModel(), 'ctsync-xml', markers);
        }

        function scheduleYamlDiagnostics(ed) {
          if (yamlCheckTimer) { clearTimeout(yamlCheckTimer); }
          var indicator = document.getElementById('checkingIndicator');
          if (indicator) { indicator.style.display = 'inline'; }
          var content = ed.getValue();
          yamlCheckTimer = setTimeout(function () {
            proxy.validateContent(JSON.stringify({ content: content, contentType: 'YAML' }), function (t) {
              if (indicator) { indicator.style.display = 'none'; }
              var r = t.responseObject();
              var markers = [];
              if (!r.ok) {
                markers.push({
                  severity: monaco.MarkerSeverity.Error,
                  message: r.error || 'Malformed YAML',
                  startLineNumber: 1, startColumn: 1, endLineNumber: 1, endColumn: 1
                });
              }
              monaco.editor.setModelMarkers(ed.getModel(), 'ctsync-yaml', markers);
            });
          }, 500);
        }

        function wireLiveDiagnostics(ed) {
          if (!ed) { return; }
          ed.onDidChangeModelContent(function () {
            if (currentContentType === 'XML') {
              runXmlDiagnostics(ed);
            } else if (currentContentType === 'YAML') {
              scheduleYamlDiagnostics(ed);
            }
          });
        }

        require.config({ paths: { vs: '${rootURL}/plugin/config-template-sync/monaco/vs' } });
        require(['vs/editor/editor.main'], function () {
          monaco.languages.json.jsonDefaults.setDiagnosticsOptions({
            validate: true, allowComments: false, schemas: []
          });
          registerXmlYamlFormatProviders();
          overrideEditor = monaco.editor.create(document.getElementById('overrideEditor'), {
            value: __overrideSeed, language: languageForType(currentContentType), automaticLayout: true
          });
          formatEditorContent(overrideEditor);
          wireLiveDiagnostics(overrideEditor);
          mergedEditor = monaco.editor.create(document.getElementById('mergedEditor'), {
            value: '', language: languageForType(currentContentType), readOnly: true, automaticLayout: true
          });
          mergedBasesEditor = monaco.editor.create(document.getElementById('mergedBasesEditor'), {
            value: '', language: languageForType(currentContentType), readOnly: true, automaticLayout: true
          });
          document.getElementById('explicitlyStandaloneCheckbox').checked = explicitlyStandalone;
          document.getElementById('addBaseChainRowBtn').disabled = explicitlyStandalone;
          if (explicitlyStandalone) {
            document.getElementById('baseChainEditor').className = 'ctsync-standalone-active';
          }
          renderBaseChainRows();
          recomputeMerge();
          attachOverrideChangeListener();
        });

        // ---- Base-chain editor (FR-51/FR-55/FR-56/FR-57/FR-71/FR-72/FR-89) ----

        function addBaseChainRow() {
          if (explicitlyStandalone) { return; } // defensive no-op — button is disabled, but guard anyway
          var defaultProject = availableProjectKeys.length > 0 ? availableProjectKeys[0] : '';
          baseChainRows.push({ projectKey: defaultProject, pinMode: 'ACTIVE', pinnedVersionNumber: 0 });
          baseChainRowExpanded.push(false); // new rows start collapsed
          renderBaseChainRows();
          recomputeMerge();
        }

        function removeBaseChainRow(index) {
          baseChainRows.splice(index, 1);
          baseChainRowExpanded.splice(index, 1); // keep both arrays in lockstep
          renderBaseChainRows();
          recomputeMerge();
        }

        function moveBaseChainRow(index, delta) {
          var target = index + delta;
          if (target &lt; 0 || target >= baseChainRows.length) { return; }
          var row = baseChainRows.splice(index, 1)[0];
          baseChainRows.splice(target, 0, row);
          var expanded = baseChainRowExpanded.splice(index, 1)[0];
          baseChainRowExpanded.splice(target, 0, expanded);
          renderBaseChainRows();
          recomputeMerge();
        }

        // FR-89: checking this clears the chain, disables Add base, and greys out the row table
        // (never hides it — see wireframe reasoning). Unchecking with zero rows reseeds the FR-56
        // default so the UI never shows a visibly-empty table with the checkbox off (which would
        // look identical to the standalone state it's distinguishing itself from).
        function onExplicitlyStandaloneChange(checked) {
          explicitlyStandalone = checked;
          if (checked) {
            baseChainRows = [];
            baseChainRowExpanded = [];
          } else if (baseChainRows.length === 0) {
            baseChainRows = [{ projectKey: availableProjectKeys.length > 0 ? availableProjectKeys[0] : '',
                               pinMode: 'ACTIVE', pinnedVersionNumber: 0 }];
            baseChainRowExpanded = [false];
          }
          document.getElementById('addBaseChainRowBtn').disabled = checked;
          document.getElementById('baseChainEditor').className = checked ? 'ctsync-standalone-active' : '';
          renderBaseChainRows();
          recomputeMerge();
        }

        function toggleBaseChainRowExpanded(index) {
          baseChainRowExpanded[index] = !baseChainRowExpanded[index];
          renderBaseChainRows();
        }

        // FR-72: row #1 (index 0) always lists every available project (NFR-8: unrestricted
        // cross-project references) — it is what ESTABLISHES the chain's content-type context, so it
        // cannot itself be filtered by a context that doesn't exist yet. Every row after it is
        // filtered to row #1's resolved ContentType. FR-61's server-side
        // checkChainTypeConsistencyOrFail remains the authoritative backstop for a stale selection
        // that predates a row-#1 project change — this is a client-side UX convenience only.
        function projectOptionsForRow(index) {
          if (index === 0 || baseChainRows.length === 0) {
            return availableProjectKeys;
          }
          var contextType = commonVersionCatalog.typeByProject[baseChainRows[0].projectKey];
          if (!contextType) {
            return availableProjectKeys; // row #1's project not yet resolvable — don't over-filter
          }
          return availableProjectKeys.filter(function (key) {
            return commonVersionCatalog.typeByProject[key] === contextType;
          });
        }

        function onBaseChainProjectChange(index, projectKey) {
          baseChainRows[index].projectKey = projectKey;
          baseChainRows[index].pinMode = 'ACTIVE';
          baseChainRows[index].pinnedVersionNumber = 0;
          renderBaseChainRows();
          recomputeMerge();
        }

        function onBaseChainModeChange(index, mode) {
          baseChainRows[index].pinMode = mode;
          if (mode === 'ACTIVE') {
            baseChainRows[index].pinnedVersionNumber = 0;
          } else {
            var versions = commonVersionCatalog.versionsByProject[baseChainRows[index].projectKey] || [];
            baseChainRows[index].pinnedVersionNumber = versions.length > 0 ? versions[0].version : 0;
          }
          renderBaseChainRows();
          recomputeMerge();
        }

        function onBaseChainPinnedVersionChange(index, versionNumber) {
          baseChainRows[index].pinnedVersionNumber = parseInt(versionNumber, 10);
          recomputeMerge();
        }

        function renderBaseChainRows() {
          var body = document.getElementById('baseChainRowsBody');
          body.innerHTML = '';
          for (var i = 0; i &lt; baseChainRows.length; i++) {
            var built = buildBaseChainRowElement(baseChainRows[i], i);
            if (Array.isArray(built)) {
              built.forEach(function (el) { body.appendChild(el); });
            } else {
              body.appendChild(built);
            }
          }
          document.getElementById('baseChainField').value = JSON.stringify(baseChainRows);
        }

        // FR-71: matches the SAME EffectiveConfigResolver/doComputeMerge response already driving
        // the Merged-bases/Merged-result panels — there must never be a second, divergent
        // computation. lastPerReference (populated by recomputeMerge from r.perReference) is
        // matched back to a given draft row by (projectKey, pinMode, pinnedVersionNumber-if-pinned)
        // — array position alone is not reliable once add/remove/reorder is mixed with an in-flight
        // debounced response, so match on content, not index.
        function findPerReferenceFor(row) {
          for (var i = 0; i &lt; lastPerReference.length; i++) {
            var ref = lastPerReference[i];
            if (ref.projectKey === row.projectKey &amp;&amp; ref.pinMode === row.pinMode
                &amp;&amp; (row.pinMode !== 'PINNED' || ref.resolvedVersionNumber === row.pinnedVersionNumber)) {
              return ref;
            }
          }
          return null; // e.g. an unresolvable/duplicate chain entry
        }

        function buildBaseChainRowElement(row, index) {
          var tr = document.createElement('tr');
          tr.className = 'ctsync-basechain-row';

          // FR-71: leading toggle cell — expands/collapses this row's read-only resolved-content
          // accordion body below.
          var toggleTd = document.createElement('td');
          var toggleLink = document.createElement('a');
          toggleLink.href = '#';
          toggleLink.className = 'ctsync-basechain-row-toggle';
          toggleLink.innerHTML = baseChainRowExpanded[index] ? '&#9662;' : '&#9656;';
          toggleLink.onclick = (function (idx) {
            return function (e) { e.preventDefault(); toggleBaseChainRowExpanded(idx); };
          })(index);
          toggleTd.appendChild(toggleLink);
          tr.appendChild(toggleTd);

          var idxTd = document.createElement('td');
          idxTd.textContent = (index + 1);
          tr.appendChild(idxTd);

          var projectTd = document.createElement('td');
          var projectSelect = document.createElement('select');
          projectSelect.className = 'jenkins-select__input';
          // FR-72: row #1 lists every project unfiltered; later rows are filtered to row #1's
          // resolved ContentType.
          var options = projectOptionsForRow(index);
          for (var p = 0; p &lt; options.length; p++) {
            var opt = document.createElement('option');
            opt.value = options[p];
            opt.text = options[p];
            if (options[p] === row.projectKey) { opt.selected = true; }
            projectSelect.appendChild(opt);
          }
          projectSelect.onchange = (function (idx) {
            return function () { onBaseChainProjectChange(idx, this.value); };
          })(index);
          projectTd.appendChild(projectSelect);
          tr.appendChild(projectTd);

          var modeTd = document.createElement('td');
          modeTd.appendChild(buildModeRadio(row, index, 'ACTIVE', 'Active'));
          modeTd.appendChild(buildModeRadio(row, index, 'PINNED', 'Pin'));
          tr.appendChild(modeTd);

          var versionTd = document.createElement('td');
          if (row.pinMode === 'PINNED') {
            var versionSelect = document.createElement('select');
            versionSelect.className = 'jenkins-select__input';
            var versions = commonVersionCatalog.versionsByProject[row.projectKey] || [];
            for (var v = 0; v &lt; versions.length; v++) {
              var vopt = document.createElement('option');
              vopt.value = versions[v].version;
              vopt.text = 'v' + versions[v].version + ' — ' + versions[v].note;
              if (versions[v].version === row.pinnedVersionNumber) { vopt.selected = true; }
              versionSelect.appendChild(vopt);
            }
            versionSelect.onchange = (function (idx) {
              return function () { onBaseChainPinnedVersionChange(idx, this.value); };
            })(index);
            versionTd.appendChild(versionSelect);
          }
          tr.appendChild(versionTd);

          var actionsTd = document.createElement('td');
          var upBtn = document.createElement('button');
          upBtn.type = 'button';
          upBtn.className = 'jenkins-button ctsync-basechain-reorder-btn';
          upBtn.title = 'Move up (higher precedence rows come later)';
          upBtn.innerHTML = '&#9650;';
          upBtn.disabled = (index === 0);
          upBtn.onclick = (function (idx) { return function () { moveBaseChainRow(idx, -1); }; })(index);
          actionsTd.appendChild(upBtn);

          var downBtn = document.createElement('button');
          downBtn.type = 'button';
          downBtn.className = 'jenkins-button ctsync-basechain-reorder-btn';
          downBtn.title = 'Move down (later rows win on overlapping keys)';
          downBtn.innerHTML = '&#9660;';
          downBtn.disabled = (index === baseChainRows.length - 1);
          downBtn.onclick = (function (idx) { return function () { moveBaseChainRow(idx, 1); }; })(index);
          actionsTd.appendChild(downBtn);

          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'jenkins-button jenkins-button--destructive ctsync-basechain-remove-btn';
          removeBtn.title = 'Remove this base from the chain';
          removeBtn.innerHTML = '&#10005;';
          removeBtn.onclick = (function (idx) { return function () { removeBaseChainRow(idx); }; })(index);
          actionsTd.appendChild(removeBtn);

          tr.appendChild(actionsTd);

          if (!baseChainRowExpanded[index]) {
            return tr; // collapsed: header row only
          }

          // FR-71: expanded — a second row directly below, one wide colspan cell holding the
          // read-only resolved view.
          var detailTr = document.createElement('tr');
          detailTr.className = 'ctsync-basechain-row-detail';
          var detailTd = document.createElement('td');
          detailTd.colSpan = 6;
          var perRef = findPerReferenceFor(row);
          if (perRef) {
            var caption = document.createElement('div');
            caption.className = 'ctsync-basechain-resolved-caption';
            caption.textContent = 'Resolved content (read-only) — ' + perRef.projectKey + ', '
                + perRef.pinMode + ' (v' + perRef.resolvedVersionNumber + ')';
            detailTd.appendChild(caption);
            var pre = document.createElement('pre');
            pre.className = 'ctsync-basechain-resolved-pre';
            pre.textContent = perRef.contentJson; // already serialized text in the resolved ContentType
            detailTd.appendChild(pre);
          } else {
            detailTd.textContent = 'Not yet resolvable — check the project/version picker above.';
          }
          detailTr.appendChild(detailTd);
          return [tr, detailTr];
        }

        function buildModeRadio(row, index, value, label) {
          var wrapper = document.createElement('label');
          wrapper.style.marginRight = '8px';
          var radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = 'baseChainMode-' + index;
          radio.checked = (row.pinMode === value);
          radio.onchange = (function (idx, v) { return function () { onBaseChainModeChange(idx, v); }; })(index, value);
          wrapper.appendChild(radio);
          wrapper.appendChild(document.createTextNode(' ' + label));
          return wrapper;
        }

        function toggleBaseChainDetail(versionNumber) {
          var el = document.getElementById('baseChainDetail-' + versionNumber);
          if (el) { el.style.display = (el.style.display === 'none') ? 'block' : 'none'; }
        }

        // Accordion layout (2026-09-02): Monaco measures its container's computed size at
        // creation time, so an editor created while its ancestor details element is closed can render
        // at zero size. "Editor" is open by default so this isn't hit on initial load, but if a
        // user collapses then reopens it, force every live Monaco instance in this section to
        // re-measure via layout() so none of them render mis-sized. Only call layout() on
        // instances that are actually non-null at the moment `toggle` fires (e.g. diffEditor only
        // exists while Compare mode is active; generatedTemplateEditor only after Generate
        // Template has been used at least once).
        document.getElementById('editorDetails').addEventListener('toggle', function (evt) {
          if (!evt.target.open) { return; }
          if (overrideEditor) { overrideEditor.layout(); }
          if (mergedEditor) { mergedEditor.layout(); }
          if (mergedBasesEditor) { mergedBasesEditor.layout(); }
          if (diffEditor) { diffEditor.layout(); }
          if (generatedTemplateEditor) { generatedTemplateEditor.layout(); }
        });

        // Auto pretty-print JSON content whenever it's (re)loaded into the editable override
        // editor, so the user never sees a minified/however-it-was-stored blob and never has to
        // trigger formatting manually. Fire-and-forget: nothing downstream depends on the
        // formatted state finishing, and formatting is idempotent. Not applied to
        // mergedEditor: it's readOnly, and Monaco's format action does not reliably run on
        // readOnly editors (microsoft/monaco-editor#978) — mergedEditor is already pretty-printed
        // via JSON.stringify(r.merged, null, 2) in recomputeMerge below.
        function formatEditorContent(ed) {
          if (!ed) { return; }
          // Retry-until-changed, not just retry-until-the-action-object-exists: calling
          // editor.action.formatDocument right after monaco.editor.create() can silently no-op
          // (getAction() already returns a truthy action, run() resolves, but zero edits are
          // applied) while Monaco's JSON format provider/worker is still warming up — no error,
          // no console output, empirically confirmed against a real Jenkins instance. So instead
          // of trusting "the action exists" as the readiness signal, keep retrying with a short
          // backoff until the content actually changes (genuinely-already-formatted content
          // simply exhausts the retry budget harmlessly, since this is a pure display nicety).
          var attemptsLeft = 6;
          function attempt() {
            var before = ed.getValue();
            var action = ed.getAction('editor.action.formatDocument');
            if (!action) {
              if (--attemptsLeft > 0) { setTimeout(attempt, 200); }
              return;
            }
            Promise.resolve(action.run()).then(function () {
              if (ed.getValue() === before &amp;&amp; --attemptsLeft > 0) {
                setTimeout(attempt, 200);
              }
            });
          }
          setTimeout(attempt, 0);
        }

        function attachOverrideChangeListener() {
          overrideEditor.onDidChangeModelContent(function () {
            clearTimeout(debounceHandle);
            // FR-38: debounced (not per-keystroke), same shape as Jenkins core's own
            // doCheckXxx live-validation callbacks (tech-lead review, 2026-08-27).
            debounceHandle = setTimeout(recomputeMerge, 300);
          });
        }

        function switchToEditMode() {
          if (editMode) { return; }
          if (diffEditor) { diffEditor.dispose(); diffEditor = null; }
          overrideEditor = monaco.editor.create(document.getElementById('overrideEditor'), {
            value: lastEditContent, language: languageForType(currentContentType), automaticLayout: true
          });
          formatEditorContent(overrideEditor);
          wireLiveDiagnostics(overrideEditor);
          attachOverrideChangeListener();
          recomputeMerge();
          editMode = true;
          clearHistorySelection();
          document.getElementById('modeEditBtn').className = 'jenkins-button jenkins-button--primary';
          document.getElementById('compareBanner').style.display = 'none';
        }

        // Click-driven Compare (2026-09-01 redesign, owner report): no checkbox anywhere —
        // clicking an unselected version row diffs the CURRENT Env-override DRAFT against that
        // one version; re-clicking the already-selected row deselects it (back to edit mode);
        // clicking a different row while already comparing swaps the right-hand pane to the
        // newly clicked version, without ever changing the left-hand pane (the draft is frozen
        // at the moment Compare mode is entered — the plain editor is swapped out for the
        // read-only diff editor, so there is no live typing to reflect while comparing anyway).
        function selectHistoryRow(version) {
          if (selectedCompareVersion === version) {
            switchToEditMode();
            return;
          }
          // JS-proxy args are sent as a single JSON-string payload, not a positional int arg — see
          // ConfigSetPage#doActivate's javadoc for why (this Stapler version's JS-proxy dispatcher
          // was empirically found to only reliably bind a single String-JSON parameter).
          proxy.compareVersions(JSON.stringify({ version: version }), function (t) {
            var r = t.responseObject();
            if (!r.ok) {
              alert(r.error);
              return;
            }
            enterCompareMode(version, r.content);
          });
        }

        function enterCompareMode(version, versionContent) {
          // Root-cause fix (owner report, live-recompute regression): onDidChangeModelContent's
          // debounce (see attachOverrideChangeListener) can still have a pending setTimeout in
          // flight from a keystroke typed just before this row was clicked. If left running, it
          // fires 300ms later against a NOW-disposed/null overrideEditor
          // (recomputeMerge -> overrideEditor.getValue() -> "Cannot read properties of null"),
          // an uncaught exception — reproduced live via Playwright: type, then immediately click a
          // history row before the debounce elapses. Cancel it here, at the exact moment
          // overrideEditor is disposed, same as the diffEditor disposal just below.
          clearTimeout(debounceHandle);
          if (overrideEditor) {
            lastEditContent = overrideEditor.getValue();
            overrideEditor.dispose();
            overrideEditor = null;
          }
          if (diffEditor) {
            diffEditor.dispose();
            diffEditor = null;
          }
          var draftModel = monaco.editor.createModel(lastEditContent, languageForType(currentContentType));
          var versionModel = monaco.editor.createModel(versionContent, languageForType(currentContentType));
          diffEditor = monaco.editor.createDiffEditor(document.getElementById('overrideEditor'), {
            readOnly: true,
            automaticLayout: true,
            renderSideBySide: true
          });
          diffEditor.setModel({ original: draftModel, modified: versionModel });
          editMode = false;
          selectedCompareVersion = version;
          lastComparedVersionContent = versionContent;
          highlightSelectedHistoryRow(version);
          document.getElementById('modeEditBtn').className = 'jenkins-button';
          document.getElementById('compareBannerText').textContent =
              'Comparing the current (unsaved) Env-override draft against v' + version + '.';
          document.getElementById('compareBanner').style.display = 'block';
        }

        // Accepts the version currently being compared into the Env-override draft and returns to
        // edit mode.
        function loadComparedIntoEditor() {
          if (!selectedCompareVersion) { return; }
          lastEditContent = lastComparedVersionContent;
          switchToEditMode();
        }

        function highlightSelectedHistoryRow(version) {
          clearHistoryHighlightOnly();
          var row = document.getElementById('historyRow-' + version);
          if (row) { row.className = 'ctsync-history-row ctsync-history-row--selected'; }
        }

        function clearHistoryHighlightOnly() {
          var rows = document.querySelectorAll('.ctsync-history-row--selected');
          for (var i = 0; i &lt; rows.length; i++) {
            rows[i].className = 'ctsync-history-row';
          }
        }

        function clearHistorySelection() {
          selectedCompareVersion = null;
          lastComparedVersionContent = '';
          clearHistoryHighlightOnly();
        }

        function recomputeMerge() {
          // Defensive guard for the same race the debounce-cancellation fix above targets: if any
          // other path ever schedules/invokes a recompute while overrideEditor is transiently
          // disposed (Compare mode), no-op instead of throwing on a null dereference.
          if (!overrideEditor) { return; }
          document.getElementById('baseChainField').value = JSON.stringify(baseChainRows);
          proxy.previewMerge(overrideEditor.getValue(), JSON.stringify(baseChainRows), explicitlyStandalone,
              function (t) {
            var r = t.responseObject();
            var indicator = document.getElementById('mergedStaleIndicator');
            if (r.ok) {
              // FR-60/§7: `merged`/`mergedBases` are already serialized text in the resolved chain's
              // ContentType, not a nested JSON object — set directly into the models. The resolved
              // `contentType` (new field) drives the Merged-bases/Env-override/Merged-result panels'
              // shared Monaco language mode via setModelLanguage (never rebuilding the editor
              // instance, to avoid disrupting an in-progress edit/cursor position).
              if (r.contentType &amp;&amp; r.contentType !== currentContentType) {
                currentContentType = r.contentType;
                monaco.editor.setModelLanguage(overrideEditor.getModel(), languageForType(currentContentType));
                monaco.editor.setModelLanguage(mergedEditor.getModel(), languageForType(currentContentType));
                monaco.editor.setModelLanguage(mergedBasesEditor.getModel(), languageForType(currentContentType));
              }
              mergedEditor.setValue(r.merged);
              mergedBasesEditor.setValue(r.mergedBases); // FR-73
              indicator.style.display = 'none';
              lastPerReference = r.perReference || [];
              // FR-71: refresh any currently-expanded row's resolved-content accordion body from the
              // freshly landed response — the accordion replaces the old inspect-drawer's refresh call.
              renderBaseChainRows();
            } else {
              // Finding 1 (tech-lead review): retain the last successfully computed merge —
              // never blank/error the panel while the override or base chain is transiently invalid.
              indicator.style.display = 'block';
            }
          });
        }

        // In-place update (2026-09-02): shows/clears the save-feedback banner for both the success
        // and error outcome of a save — success briefly flashes then auto-hides (there is no page
        // navigation anymore to signal "done" the way a redirect used to); an error is left visible
        // until the next save attempt clears or replaces it. Mirrors CommonConfigSetPage's identical
        // helper.
        function showSaveBanner(message, isError) {
          var banner = document.getElementById('saveBanner');
          banner.textContent = message;
          banner.className = isError ? 'alert alert-danger' : 'alert alert-success';
          banner.style.display = 'block';
          if (!isError) {
            setTimeout(function () {
              if (banner.textContent === message) { banner.style.display = 'none'; }
            }, 4000);
          }
        }

        // In-place update (2026-09-02): Save/Save &amp; Activate now call proxy.save(...) directly —
        // no &lt;form&gt; submit, no page reload. Content comes straight from the live Env-override
        // Monaco editor (mirrors prepareSubmit's old editMode/lastEditContent fallback exactly).
        function saveClicked(activate) {
          var content = (editMode &amp;&amp; overrideEditor) ? overrideEditor.getValue() : lastEditContent;
          document.getElementById('baseChainField').value = JSON.stringify(baseChainRows);
          var note = document.getElementById('noteField').value;
          var payload = {
            content: content,
            note: note,
            activate: activate,
            baseChainJson: JSON.stringify(baseChainRows),
            explicitlyStandalone: explicitlyStandalone
          };
          document.getElementById('saveBtn').disabled = true;
          document.getElementById('saveActivateBtn').disabled = true;
          proxy.save(JSON.stringify(payload), function (t) {
            document.getElementById('saveBtn').disabled = false;
            document.getElementById('saveActivateBtn').disabled = false;
            var r = t.responseObject();
            if (!r.ok) {
              showSaveBanner(r.error, true);
              return;
            }
            showSaveBanner('Saved.', false);
            renderVersionHistoryRows(r.versions);
            if (selectedCompareVersion !== null) { highlightSelectedHistoryRow(selectedCompareVersion); }
            document.getElementById('noteField').value = '';
            // FR-74: refresh the discard-target baseline on every successful save — "last saved"
            // always means the most recent successful save, not the original page load (saves are
            // already in-place AJAX with no page reload, so __overrideSeed/__baseChainSeed alone
            // would go stale after the first save).
            lastSavedOverrideContent = content;
            lastSavedBaseChainJson = JSON.stringify(baseChainRows);
            lastSavedExplicitlyStandalone = explicitlyStandalone;
          });
        }

        // FR-74: pure client-side revert to the last-SAVED state — no new server endpoint, no page
        // reload. Reverts the base-chain editor's draft rows, the explicitlyStandalone checkbox, and
        // the Env-override editor's content, reusing switchToEditMode()'s existing editor-recreation
        // logic (same side effects "discard" needs: dispose diffEditor if present, recreate
        // overrideEditor from lastEditContent, re-wire diagnostics/change-listener, recomputeMerge(),
        // clear history-row selection, reset the mode-toggle button/compare banner). Never touches
        // any already-saved version, version-history table, or active pointer.
        function discardAllChangesClicked() {
          if (!window.confirm('Discard all unsaved changes to the base chain and env override? '
              + 'This cannot be undone.')) {
            return;
          }
          baseChainRows = JSON.parse(lastSavedBaseChainJson);
          baseChainRowExpanded = baseChainRows.map(function () { return false; });
          explicitlyStandalone = lastSavedExplicitlyStandalone;
          document.getElementById('explicitlyStandaloneCheckbox').checked = explicitlyStandalone;
          document.getElementById('addBaseChainRowBtn').disabled = explicitlyStandalone;
          document.getElementById('baseChainEditor').className = explicitlyStandalone ? 'ctsync-standalone-active' : '';
          renderBaseChainRows();

          lastEditContent = lastSavedOverrideContent;
          // switchToEditMode() no-ops if editMode is already true (its normal Compare-mode-exit
          // guard) — force it to actually recreate overrideEditor from the just-reverted
          // lastEditContent regardless of current mode, since discard must reset the live editor's
          // content even when the operator was never in Compare mode to begin with. Dispose the
          // still-live overrideEditor first (mirroring enterCompareMode's own disposal step) so
          // switchToEditMode does not stack a second Monaco instance into the same container.
          clearTimeout(debounceHandle);
          if (editMode &amp;&amp; overrideEditor) {
            overrideEditor.dispose();
            overrideEditor = null;
          }
          editMode = false;
          switchToEditMode();
        }

        // In-place-update row templating (2026-09-02): clones #historyRowTemplate (its static
        // label/title text already correctly localized by Jelly) and fills in only the per-row
        // dynamic values, including the base-chain detail lines — used by both saveClicked (may
        // append a version) and activateVersion (flips which version is active) instead of
        // location.reload()-ing the whole page.
        function renderVersionHistoryRows(versions) {
          var tbody = document.getElementById('versionHistoryTbody');
          tbody.innerHTML = '';
          for (var i = 0; i &lt; versions.length; i++) {
            tbody.appendChild(buildHistoryRowElement(versions[i]));
          }
        }

        function buildHistoryRowElement(v) {
          var tpl = document.getElementById('historyRowTemplate');
          var tr = tpl.content.firstElementChild.cloneNode(true);
          tr.id = 'historyRow-' + v.versionNumber;
          tr.onclick = function () { selectHistoryRow(v.versionNumber); };
          tr.onkeydown = function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              selectHistoryRow(v.versionNumber);
            }
          };
          tr.querySelector('.js-version').textContent = 'v' + v.versionNumber;
          tr.querySelector('.js-created').textContent = v.timestampEpochMillis;
          tr.querySelector('.js-createdBy').textContent = v.author;
          tr.querySelector('.js-note').textContent = v.note;

          var chain = v.baseChain || [];
          var badge = tr.querySelector('.js-standalone-badge');
          var toggle = tr.querySelector('.js-basechain-toggle');
          if (v.explicitlyStandalone) {
            // FR-89: shows the badge INSTEAD OF the N-bases link — a standalone version always has
            // an empty baseChain (enforced at write time), which would otherwise render identically
            // to "0 bases" via any other route.
            badge.style.display = 'inline';
            toggle.style.display = 'none';
          } else {
            badge.style.display = 'none';
            toggle.style.display = 'inline';
          }
          tr.querySelector('.js-basechain-count').textContent = chain.length;
          var detail = tr.querySelector('.js-basechain-detail');
          detail.id = 'baseChainDetail-' + v.versionNumber;
          if (chain.length === 0) {
            detail.textContent = '(no declared chain — resolves to this env\'s own project, ACTIVE)';
          } else {
            detail.innerHTML = '';
            for (var c = 0; c &lt; chain.length; c++) {
              var ref = chain[c];
              var line = document.createElement('div');
              line.textContent = ref.projectKey + ' — ' + ref.pinMode
                  + (ref.pinMode === 'PINNED' ? ' (v' + ref.pinnedVersionNumber + ')' : '');
              detail.appendChild(line);
            }
          }
          toggle.onclick = (function (num) {
            return function (e) { e.stopPropagation(); e.preventDefault(); toggleBaseChainDetail(num); };
          })(v.versionNumber);

          var badge = tr.querySelector('.js-activeBadge');
          badge.textContent = v.active ? ('● ' + tpl.dataset.activeLabel) : '';
          var btn = tr.querySelector('.js-activate-btn');
          if (v.active) {
            btn.disabled = true;
            btn.setAttribute('data-always-disabled', 'true');
            btn.title = tpl.dataset.alreadyActiveTitle;
          } else {
            btn.title = 'Activate version ' + v.versionNumber + ' without changing the editor content';
            btn.onclick = (function (num) {
              return function (e) { e.stopPropagation(); activateVersion(num); };
            })(v.versionNumber);
          }
          return tr;
        }

        // In-place-update row templating (2026-09-02): same technique as the version-history table
        // above, for the secrets-manifest table — used by addSecret/removeSecret instead of
        // location.reload()-ing the whole page. Mirrors CommonConfigSetPage's identical helpers.
        function renderSecretsManifestRows(manifest) {
          var tbody = document.getElementById('secretsManifestTbody');
          tbody.innerHTML = '';
          for (var i = 0; i &lt; manifest.length; i++) {
            tbody.appendChild(buildSecretRowElement(manifest[i]));
          }
        }

        function buildSecretRowElement(entry) {
          var tpl = document.getElementById('secretRowTemplate');
          var tr = tpl.content.firstElementChild.cloneNode(true);
          tr.querySelector('.js-secret-path').textContent = entry.path;
          tr.querySelector('.js-secret-cred').textContent = entry.credentialId;
          var btn = tr.querySelector('.ctsync-remove-secret-btn');
          btn.setAttribute('data-secret-path', entry.path);
          btn.title = tpl.dataset.removeTitle;
          btn.onclick = function () { removeSecret(entry.path); };
          return tr;
        }

        // FR-41: zero-argument proxy.generateTemplate() call (server-side signature has no
        // overlayJson/contentJson parameter at all — FR-16), so there is structurally no way this
        // can read the override panel's in-progress unsaved buffer, even though that buffer sits
        // right there two columns over in the 3-panel table this replaces.
        function showGeneratedTemplateView() {
          proxy.generateTemplate(function (t) {
            var r = t.responseObject();
            if (!r.ok) {
              alert(r.error);
              return;
            }
            // FR-64/§7: `template` is already serialized text in the resolved contentType.
            lastGeneratedTemplateText = r.template;
            document.getElementById('mergeLayout').style.display = 'none';
            document.getElementById('generateBanner').style.display = 'block';
            document.getElementById('generatedTemplatePanel').style.display = 'block';
            document.getElementById('generateTemplateBtn').style.display = 'none';
            document.getElementById('backTo3PanelBtn').style.display = 'inline-block';
            if (generatedTemplateEditor) {
              generatedTemplateEditor.setValue(lastGeneratedTemplateText);
              monaco.editor.setModelLanguage(generatedTemplateEditor.getModel(), languageForType(r.contentType));
            } else {
              generatedTemplateEditor = monaco.editor.create(document.getElementById('generatedTemplateEditor'), {
                value: lastGeneratedTemplateText,
                language: languageForType(r.contentType),
                readOnly: true,
                automaticLayout: true
              });
            }
          });
        }

        // Restores the normal 3-panel layout exactly as it was — the override panel's in-progress
        // edits are untouched underneath, since the generated-template view never disturbed them.
        function backTo3PanelView() {
          document.getElementById('mergeLayout').style.display = '';
          document.getElementById('generateBanner').style.display = 'none';
          document.getElementById('generatedTemplatePanel').style.display = 'none';
          document.getElementById('generateTemplateBtn').style.display = 'inline-block';
          document.getElementById('backTo3PanelBtn').style.display = 'none';
        }

        // FR-42: standard browser Clipboard API, copies the exact editor text verbatim.
        function copyGeneratedTemplate() {
          navigator.clipboard.writeText(
              generatedTemplateEditor ? generatedTemplateEditor.getValue() : lastGeneratedTemplateText);
        }

        // FR-46: only one activate call may be in flight at a time for this Config Set — disable
        // EVERY Activate button (not just the one clicked) before the call, and re-enable them all
        // on failure (success reloads the page, so there's nothing to re-enable in that path).
        function setActivateButtonsDisabled(disabled) {
          var buttons = document.querySelectorAll('.ctsync-activate-btn');
          for (var i = 0; i &lt; buttons.length; i++) {
            // FR-47: the already-active row's button is permanently disabled — never re-enable it
            // as a side effect of the busy-toggle finishing.
            if (buttons[i].getAttribute('data-always-disabled') === 'true') { continue; }
            buttons[i].disabled = disabled;
          }
        }

        function activateVersion(v) {
          setActivateButtonsDisabled(true);
          // See compareVersions' comment above: single JSON-string payload, not a plain int arg.
          proxy.activate(JSON.stringify({ version: v }), function (t) {
            var r = t.responseObject();
            if (r.ok) {
              // In-place update (2026-09-02): re-render just the version-history table's
              // Active-badge/button-disabled-state from the fresh versions list — nothing else on
              // the page (override editor draft, base-chain editor draft, accordion state) is
              // touched.
              renderVersionHistoryRows(r.versions);
              if (selectedCompareVersion !== null) { highlightSelectedHistoryRow(selectedCompareVersion); }
            } else {
              setActivateButtonsDisabled(false);
              alert(r.error);
            }
          });
        }

        function addSecret() {
          var path = document.getElementById('secretPath').value;
          var cred = document.getElementById('secretCredentialId').value;
          proxy.addSecret(JSON.stringify({ path: path, credentialId: cred }), function (t) {
            var r = t.responseObject();
            if (r.ok) {
              // In-place update (2026-09-02): re-render just the secrets-manifest table from the
              // fresh manifest list.
              renderSecretsManifestRows(r.secretsManifest);
              document.getElementById('secretPath').value = '';
            } else {
              alert(r.error);
            }
          });
        }

        // OQ-1 CRUD completion: unbind a previously-registered secret path. In-place update
        // (2026-09-02): re-renders the secrets-manifest table from the fresh manifest list on
        // success (same after-action shape as addSecret above) so the removal is reflected without
        // a stale row lingering client-side — no page reload.
        function removeSecret(path) {
          proxy.removeSecret(JSON.stringify({ path: path }), function (t) {
            var r = t.responseObject();
            if (r.ok) { renderSecretsManifestRows(r.secretsManifest); } else { alert(r.error); }
          });
        }
      </script>

      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
