<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="${it.projectKey} — Config Templates">
    <l:main-panel>
      <p><a href="${rootURL}/configTemplates/">&#8592; ${%backAllLink}</a></p>
      <h1>${it.projectKey}</h1>
      <p><a href="common">${%openCommonLink} &#8594;</a></p>

      <h2>${%envHeading}</h2>
      <table class="jenkins-table sortable" style="width:100%">
        <thead>
          <tr>
            <th>${%column.environment}</th>
            <th>${%column.activeVersion}</th>
          </tr>
        </thead>
        <tbody>
          <j:forEach var="cs" items="${it.envConfigSets}">
            <tr>
              <td><a href="${cs.environment}/">${cs.environment}</a></td>
              <td>
                <j:choose>
                  <j:when test="${cs.activeVersion != null}">v${cs.activeVersion.versionNumber}</j:when>
                  <j:otherwise>${%noActiveVersion}</j:otherwise>
                </j:choose>
              </td>
            </tr>
          </j:forEach>
        </tbody>
      </table>

      <h3>${%newEnv.heading}</h3>
      <p>Overrides common Config Set: <code>${it.projectKey}-common</code> (structural pairing, FR-35)</p>
      <input type="text" id="newEnvName" placeholder="environment (e.g. dev)" class="setting-input"/>
      <button type="button" class="jenkins-button jenkins-button--primary"
              title="${%newEnv.buttonTitle}"
              onclick="window.location.href = encodeURIComponent(document.getElementById('newEnvName').value) + '/';">${%newEnv.buttonLabel}</button>
    </l:main-panel>
  </l:layout>
</j:jelly>
