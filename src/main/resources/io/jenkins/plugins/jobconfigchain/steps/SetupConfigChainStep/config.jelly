<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%File}" field="file">
    <f:textbox/>
  </f:entry>
  <f:entry field="useBase">
    <f:checkbox title="${%Use a global base Config Set}"/>
  </f:entry>
  <f:entry title="${%Config key}" field="configKey">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Version}" field="version">
    <f:number min="1" step="1"/>
  </f:entry>
  <f:entry title="${%Redeploy from run}" field="redeployFromRun">
    <f:textbox/>
  </f:entry>
</j:jelly>
