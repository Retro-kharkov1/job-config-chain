<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%file}" field="file">
    <f:textbox/>
  </f:entry>
  <f:entry field="useBase">
    <f:checkbox title="${%useBase}"/>
  </f:entry>
  <f:entry title="${%configKey}" field="configKey">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%version}" field="version">
    <f:number min="1" step="1"/>
  </f:entry>
  <f:entry title="${%redeployFromRun}" field="redeployFromRun">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%encoding}" field="encoding">
    <f:textbox/>
  </f:entry>
</j:jelly>
