<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%file}" field="file">
    <f:textbox/>
  </f:entry>
  <f:optionalBlock title="${%useBase}" field="useBase" inline="true">
    <f:entry title="${%configKey}" field="configKey">
      <f:textbox/>
    </f:entry>
  </f:optionalBlock>
  <f:entry title="${%version}" field="version">
    <f:number min="1" step="1"/>
  </f:entry>
  <f:entry title="${%encoding}" field="encoding">
    <f:textbox/>
  </f:entry>
</j:jelly>
