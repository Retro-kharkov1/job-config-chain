<?jelly escape-by-default='true'?>
<!--
  Block 2 of 4: secrets manifest. Shared between EnvConfigSetPage/index.jelly and
  ConfigTemplatesJobAction/index.jelly (tech-lead design contract, 2026-09-09). Relies on ${it}
  exposing: exists, secretsManifestForDisplay (Map<String,String>), availableCredentialIds. Every
  id/function referenced here (secretsManifestTbody, addSecret, removeSecret) must be defined by
  BOTH hosts' own page-level <script>.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">
  <div id="secretsManifestDetails">
  <f:section title="${%secretsManifest.heading}">
    <p>A path listed here is structurally locked: the editor below may only hold the literal
       <code>__SECRET__</code> placeholder at this path — save is rejected otherwise. The real
       value is supplied only via the Jenkins credential picked below, never typed here.</p>
    <!-- Empty-state row (ux-ui-designer correction, 2026-09-11): a zero-secret manifest renders as
         ONE spanning row inside the table body — the "Dotted path | Credential" header stays
         visible either way. renderSecretsManifestRows (both hosts' own script) inserts/removes
         this row directly instead of toggling a separate placeholder div. -->
    <div id="secretsManifestTableWrap" class="ctsync-scroll-table">
      <table class="jenkins-table" style="width:100%">
        <thead><tr><th>${%column.dottedPath}</th><th>${%column.credential}</th><th/></tr></thead>
        <tbody id="secretsManifestTbody">
          <j:choose>
            <j:when test="${it.exists and !it.secretsManifestForDisplay.isEmpty()}">
              <j:forEach var="entry" items="${it.secretsManifestForDisplay.entrySet()}">
                <tr>
                  <td>${entry.key}</td>
                  <td>${entry.value}</td>
                  <td>
                    <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn"
                            data-secret-path="${entry.key}"
                            title="${%removeSecret.title}"
                            onclick="removeSecret(this.getAttribute('data-secret-path'));">&#128465; ${%removeSecret.label}</button>
                  </td>
                </tr>
              </j:forEach>
            </j:when>
            <j:otherwise>
              <tr class="ctsync-empty-state-row"><td colspan="3">${%emptyState.noSecrets}</td></tr>
            </j:otherwise>
          </j:choose>
        </tbody>
      </table>
    </div>
    <template id="secretRowTemplate" data-remove-title="${%removeSecret.title}">
      <tr>
        <td class="js-secret-path"/>
        <td class="js-secret-cred"/>
        <td>
          <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn">
            &#128465; ${%removeSecret.label}</button>
        </td>
      </tr>
    </template>
    <f:entry title="${%addSecret.entryTitle}">
      <div class="ctsync-secret-form">
        <div class="ctsync-secret-form-fields">
          <input class="setting-input ctsync-secret-path-input" type="text" id="secretPath" placeholder="database.password"/>
          <div class="jenkins-select">
            <select class="jenkins-select__input" id="secretCredentialId">
              <j:forEach var="cid" items="${it.availableCredentialIds}">
                <option value="${cid}">${cid}</option>
              </j:forEach>
            </select>
          </div>
        </div>
        <button type="button" class="jenkins-button"
                title="${%bindCredential.title}"
                onclick="addSecret();">${%bindCredential.label}</button>
      </div>
    </f:entry>
  </f:section>
  </div>
</j:jelly>
