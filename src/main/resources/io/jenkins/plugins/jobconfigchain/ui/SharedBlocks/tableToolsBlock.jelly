<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!--
    Per-column filtering for the plugin's data tables (owner request, 2026-09-21).

    Sorting is NOT implemented here: Jenkins core already ships scripts/sortable.js and loads it on
    every page (jenkins-core 2.555.3, lib/layout/layout.jelly), activating for any table carrying
    the "sortable" class - core's own buildListTable.jelly and projectView.jelly use exactly
    class="jenkins-table sortable". Re-implementing a comparator here would be more code and would
    look foreign next to native Jenkins tables, so the tables simply opt in to the core behaviour
    and this block only adds what core has no equivalent for.

    One implementation, three consumers: the Config Sets list, Version history and Secrets manifest
    each just tag their table with ctsync-filterable. The Base chain table deliberately does not -
    its row order IS the merge-patch precedence, so neither sorting nor filtering may reorder or
    hide rows there without misrepresenting which value wins.
  -->
  <template id="ctsyncTableToolsStrings"
            data-filter-placeholder="${%filter.placeholder}"
            data-count-label="${%filter.count}"
            data-no-matches="${%filter.noMatches}"
            data-any-label="${%filter.any}"/>

  <style>
    .ctsync-filter-row th {
      padding-top: 4px;
      padding-bottom: 6px;
      background: inherit;
    }
    .ctsync-filter-input {
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      padding: 2px 6px;
      font-size: 12px;
      font-weight: normal;
    }
    .ctsync-filter-count {
      margin: 4px 2px 0;
      font-size: 12px;
      color: var(--text-color-secondary, #666);
    }
    /* Hidden rather than removed, so a sort performed while a filter is active still sees the
       full row set and the filter can be widened again without a re-render. */
    .ctsync-filter-count[hidden] { display: none; }
  </style>

  <script><![CDATA[
    (function () {
      function strings() {
        var tpl = document.getElementById('ctsyncTableToolsStrings');
        return {
          placeholder: (tpl && tpl.dataset.filterPlaceholder) || 'Filter',
          count: (tpl && tpl.dataset.countLabel) || '{0} of {1}',
          noMatches: (tpl && tpl.dataset.noMatches) || 'No rows match the filter',
          any: (tpl && tpl.dataset.anyLabel) || 'Any'
        };
      }

      function format(template, a, b) {
        return template.replace('{0}', String(a)).replace('{1}', String(b));
      }

      // Rows the table renders for its own state, not data: the server-rendered empty state and
      // the row this script inserts when nothing matches. Filtering or counting them would make
      // an empty table report one row, and could hide the very message explaining the emptiness.
      function isStructuralRow(tr) {
        return tr.classList.contains('ctsync-empty-state-row')
            || tr.classList.contains('ctsync-no-match-row');
      }

      function dataRows(tbody) {
        return Array.prototype.filter.call(tbody.rows, function (tr) { return !isStructuralRow(tr); });
      }

      function wire(table) {
        var thead = table.tHead;
        var tbody = table.tBodies[0];
        if (!thead || !tbody || table.dataset.ctsyncFilterWired === 'true') { return; }
        table.dataset.ctsyncFilterWired = 'true';

        var s = strings();
        var headerCells = Array.prototype.slice.call(thead.rows[0].cells);

        var filterRow = thead.insertRow(-1);
        filterRow.className = 'ctsync-filter-row';
        var inputs = [];
        headerCells.forEach(function (th, index) {
          var cell = document.createElement('th');
          // A column with no header text is an actions/control column - there is nothing
          // meaningful to type against it, and an input there would just eat width.
          if (th.textContent.trim() !== '') {
            // A column whose values come from a fixed set (a content type, an active flag) gets a
            // picker rather than a text box: the values are already known, so making the user
            // guess and type them - and get nothing when they type "json" for a cell reading
            // "JSON" - would be the wrong model. The column declares this itself in the markup;
            // inferring it from how few distinct values happen to be present today would silently
            // flip to a text box as soon as real data grew more varied.
            var enumerable = th.dataset.ctsyncFilter === 'enum';
            var control;
            if (enumerable) {
              control = document.createElement('select');
              control.className = 'jenkins-select__input ctsync-filter-input';
            } else {
              control = document.createElement('input');
              control.type = 'search';
              control.className = 'jenkins-input ctsync-filter-input';
              control.placeholder = s.placeholder;
            }
            control.setAttribute('aria-label', s.placeholder + ': ' + th.textContent.trim());
            // Core's sortable binds its click handler on the header; without this, using a filter
            // would also re-sort the table under the user.
            control.addEventListener('click', function (e) { e.stopPropagation(); });
            control.addEventListener(enumerable ? 'change' : 'input', function () { apply(table); });
            inputs.push({ index: index, input: control, enumerable: enumerable });
            cell.appendChild(control);
          }
          filterRow.appendChild(cell);
        });
        table.ctsyncFilterInputs = inputs;
        syncEnumOptions(table);

        var count = document.createElement('div');
        count.className = 'ctsync-filter-count';
        count.hidden = true;
        table.parentNode.insertBefore(count, table.nextSibling);
        table.ctsyncFilterCount = count;

        // Version history and Secrets manifest rebuild their tbody after Save/Activate. Without
        // this, an active filter would silently stop applying to the rows that replaced the ones
        // it was filtering - the table would look unfiltered while the inputs still held text.
        //
        // The callback must ignore the no-match row, because apply() inserts and removes that row
        // itself. A simple "currently applying" flag does NOT work here: observer callbacks are
        // delivered as a microtask, so they run after apply() has already cleared the flag, and
        // each pass re-triggers the next - an infinite loop that hangs the tab (hit live while
        // verifying this feature). Filtering the records by what actually changed is what breaks
        // the cycle.
        if (window.MutationObserver) {
          var observer = new MutationObserver(function (records) {
            var onlyOurOwnRows = records.every(function (record) {
              var touched = Array.prototype.slice.call(record.addedNodes)
                  .concat(Array.prototype.slice.call(record.removedNodes));
              return touched.length > 0 && touched.every(function (node) {
                return node.nodeType === 1 && node.classList.contains('ctsync-no-match-row');
              });
            });
            if (onlyOurOwnRows) { return; }
            syncEnumOptions(table);
            apply(table);
          });
          observer.observe(tbody, { childList: true });
        }
      }

      // Options come from the column's actual cells, not a hardcoded list: the plugin's content
      // types can grow, and a stale hardcoded set would offer values that match nothing or omit
      // ones that exist. Re-run after an AJAX re-render, preserving the current selection so a
      // Save does not silently widen an active filter.
      function syncEnumOptions(table) {
        var s = strings();
        (table.ctsyncFilterInputs || []).forEach(function (f) {
          if (!f.enumerable) { return; }
          var previous = f.input.value;
          var seen = [];
          dataRows(table.tBodies[0]).forEach(function (tr) {
            var cell = tr.cells[f.index];
            var text = cell ? cell.textContent.trim() : '';
            if (text !== '' && seen.indexOf(text) === -1) { seen.push(text); }
          });
          seen.sort();
          f.input.innerHTML = '';
          var any = document.createElement('option');
          any.value = '';
          any.text = s.any;
          f.input.appendChild(any);
          seen.forEach(function (value) {
            var option = document.createElement('option');
            option.value = value;
            option.text = value;
            f.input.appendChild(option);
          });
          // Only restore a selection that still exists; otherwise the control would display a
          // value the table can no longer produce, filtering everything away with no way back.
          f.input.value = seen.indexOf(previous) !== -1 ? previous : '';
        });
      }

      function apply(table) {
        var tbody = table.tBodies[0];
        var inputs = table.ctsyncFilterInputs || [];
        var s = strings();
        var terms = inputs
            .map(function (f) {
              return { index: f.index, enumerable: f.enumerable,
                       value: f.input.value.trim().toLowerCase() };
            })
            .filter(function (f) { return f.value !== ''; });

        var rows = dataRows(tbody);
        var visible = 0;
        rows.forEach(function (tr) {
          var match = terms.every(function (t) {
            var cell = tr.cells[t.index];
            if (!cell) { return false; }
            var text = cell.textContent.trim().toLowerCase();
            // A picked option is an exact value, so match it exactly - a substring test would let
            // "XML" also match a hypothetical "XMLA". Typed text stays a substring search.
            return t.enumerable ? text === t.value : text.indexOf(t.value) !== -1;
          });
          tr.style.display = match ? '' : 'none';
          if (match) { visible++; }
        });

        // Only touch the no-match row when its presence actually needs to change. Removing and
        // re-adding an identical row on every keystroke would churn the DOM and emit mutation
        // records for no reason.
        var existing = tbody.querySelector('.ctsync-no-match-row');
        var wanted = terms.length > 0 && visible === 0 && rows.length > 0;
        if (existing && !wanted) {
          existing.remove();
        } else if (!existing && wanted) {
          var tr = document.createElement('tr');
          tr.className = 'ctsync-no-match-row ctsync-empty-state-row';
          var td = document.createElement('td');
          td.colSpan = table.tHead.rows[0].cells.length;
          td.textContent = s.noMatches;
          tr.appendChild(td);
          tbody.appendChild(tr);
        }

        var count = table.ctsyncFilterCount;
        if (count) {
          count.hidden = terms.length === 0;
          count.textContent = format(s.count, visible, rows.length);
        }
      }

      function init() {
        Array.prototype.forEach.call(document.querySelectorAll('table.ctsync-filterable'), wire);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  ]]></script>
</j:jelly>
