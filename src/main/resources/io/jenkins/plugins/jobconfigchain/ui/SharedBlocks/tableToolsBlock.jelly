<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!--
    Per-column filtering for the plugin's data tables (owner request, 2026-09-21).

    Sorting itself is core's: Jenkins ships scripts/sortable.js, loads it on every page, and
    activates it for any table carrying the "sortable" class. This block only adds filtering, which
    core has no equivalent for - and is shaped around two hard constraints found by reading core's
    sortable.js (2.555.3) rather than assuming:

      * It sorts `table.rows` from index 1 onward, and that collection spans thead AND tbody. A
        second header row is therefore treated as data: core physically moves it into tbody and
        sorts it among the rows. Seen live - an earlier version of this block put the filters in
        their own thead row, and the first sort dragged that row into the body.
      * getSorter() reads `rows[1]` to decide whether a column sorts as text, number or date, so an
        extra row near the top corrupts that detection silently - something no amount of
        keep-it-pinned styling would fix.

    Hence the filter controls live INSIDE the existing header cells, and the status line lives
    OUTSIDE the table. Nothing is added to the table's row set at all.

    One implementation, three consumers: the Config Sets list, Version history and Secrets manifest
    tag their table with ctsync-filterable. The Base chain table deliberately does not - its row
    order IS the merge-patch precedence, so neither sorting nor filtering may reorder or hide rows
    there without misrepresenting which value wins.
  -->
  <template id="ctsyncTableToolsStrings"
            data-filter-placeholder="${%filter.placeholder}"
            data-count-label="${%filter.count}"
            data-no-matches="${%filter.noMatches}"
            data-any-label="${%filter.any}"/>

  <style>
    .ctsync-filter-input {
      display: block;
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      margin-top: 4px;
      padding: 2px 6px;
      font-size: 12px;
      font-weight: normal;
    }
    .ctsync-filter-status {
      margin: 4px 2px 0;
      font-size: 12px;
      color: var(--text-color-secondary, #666);
    }
    .ctsync-filter-status[hidden] { display: none; }
  </style>

  <script><![CDATA[
    (function () {
      function strings() {
        var tpl = document.getElementById('ctsyncTableToolsStrings');
        return {
          placeholder: (tpl && tpl.dataset.filterPlaceholder) || 'Filter',
          count: (tpl && tpl.dataset.countLabel) || '{0} of {1}',
          noMatches: (tpl && tpl.dataset.noMatches) || 'No rows match the filter',
          any: (tpl && tpl.dataset.anyLabel) || 'Any'
        };
      }

      function format(template, a, b) {
        return template.replace('{0}', String(a)).replace('{1}', String(b));
      }

      // The server renders its own "nothing here yet" row inside tbody. Counting it would make an
      // empty table report one row, and filtering it would hide the very message explaining the
      // emptiness.
      function dataRows(tbody) {
        return Array.prototype.filter.call(tbody.rows, function (tr) {
          return !tr.classList.contains('ctsync-empty-state-row');
        });
      }

      // Core replaces each header cell's innerHTML wholesale when it wires sorting, so a control
      // placed there first would be swallowed into the sort link. Core exposes table.sortable once
      // it has run; wait for that rather than racing it. The wait is bounded so a table that never
      // gets sorting still ends up with its filters.
      function whenSortingWired(table, callback) {
        if (!table.classList.contains('sortable') || table.sortable) { callback(); return; }
        var attempts = 0;
        (function poll() {
          if (table.sortable || attempts++ > 50) { callback(); return; }
          setTimeout(poll, 20);
        })();
      }

      function buildControl(th, s) {
        // A column whose values come from a fixed set (a content type, an active flag) gets a
        // picker rather than a text box: the values are already known, so making the user guess
        // and type them - and get nothing when they type "json" for a cell reading "JSON" - would
        // be the wrong model. The column declares this itself; inferring it from how few distinct
        // values happen to be present today would silently flip to a text box as soon as real data
        // grew more varied.
        var enumerable = th.dataset.ctsyncFilter === 'enum';
        var control;
        if (enumerable) {
          control = document.createElement('select');
          control.className = 'jenkins-select__input ctsync-filter-input';
        } else {
          control = document.createElement('input');
          control.type = 'search';
          control.className = 'jenkins-input ctsync-filter-input';
          control.placeholder = s.placeholder;
        }
        return { control: control, enumerable: enumerable };
      }

      function wire(table) {
        var thead = table.tHead;
        var tbody = table.tBodies[0];
        if (!thead || !tbody || table.dataset.ctsyncFilterWired === 'true') { return; }
        table.dataset.ctsyncFilterWired = 'true';

        var s = strings();
        var inputs = [];

        Array.prototype.forEach.call(thead.rows[0].cells, function (th, index) {
          // Skip columns there is nothing meaningful to filter on. Two signals, because the
          // action columns are not spelled consistently: the secrets tables render an empty
          // header, while the version-history tables render a captioned "Actions" column. An
          // empty caption alone was NOT enough - every row's action cell holds the same button
          // label, so a filter there matched either everything or nothing, and one stray
          // keystroke hid a table that plainly had data while claiming no rows matched.
          // data-sort-disable is core's own marker for "this column is not orderable"; a column
          // that cannot be ordered by its content cannot sensibly be filtered by it either.
          var caption = th.textContent.trim();
          if (caption === '' || th.dataset.sortDisable) { return; }

          var built = buildControl(th, s);
          var control = built.control;
          control.setAttribute('aria-label', s.placeholder + ': ' + caption);
          // Core binds sorting to the anchor that now wraps the caption in this same cell. Without
          // this, using a filter would also re-sort the table under the user.
          control.addEventListener('click', function (e) { e.stopPropagation(); });
          control.addEventListener('mousedown', function (e) { e.stopPropagation(); });
          control.addEventListener(built.enumerable ? 'change' : 'input', function () {
            apply(table);
          });
          th.appendChild(control);
          inputs.push({ index: index, input: control, enumerable: built.enumerable });
        });

        table.ctsyncFilterInputs = inputs;
        syncEnumOptions(table);

        var status = document.createElement('div');
        status.className = 'ctsync-filter-status';
        status.hidden = true;
        // Outside the SCROLL WRAPPER, not merely outside the table. The wrapper caps its height
        // and scrolls internally, so a status line placed next to the table would sit below the
        // fold of the very box it reports on - the user would have to scroll a miniature inner
        // pane to discover why the table looks empty. That defeats the whole reason this line is
        // not a row in tbody.
        var scrollWrap = table.closest ? table.closest('.ctsync-scroll-table') : null;
        var anchor = scrollWrap || table;
        anchor.parentNode.insertBefore(status, anchor.nextSibling);
        table.ctsyncFilterStatus = status;

        // Version history and Secrets manifest rebuild their tbody after Save/Activate, and a sort
        // re-appends every row. Without this, an active filter would silently stop applying to the
        // rows that replaced the ones it was filtering - the table would look unfiltered while the
        // controls still held a value. Nothing in this block adds or removes tbody rows, so the
        // observer cannot retrigger itself.
        // `typeof window` first: this script is also evaluated by the Nashorn JS-engine
        // unit tests, which provide a document stub but no window, and `window.x` throws
        // a ReferenceError there rather than returning undefined.
        if (typeof window !== 'undefined' && window.MutationObserver) {
          new MutationObserver(function () {
            syncEnumOptions(table);
            apply(table);
          }).observe(tbody, { childList: true });
        }
      }

      // Options come from the column's actual cells, not a hardcoded list: the plugin's content
      // types can grow, and a stale hardcoded set would offer values that match nothing or omit
      // ones that exist.
      function syncEnumOptions(table) {
        var s = strings();
        (table.ctsyncFilterInputs || []).forEach(function (f) {
          if (!f.enumerable) { return; }
          var previous = f.input.value;
          var seen = [];
          dataRows(table.tBodies[0]).forEach(function (tr) {
            var cell = tr.cells[f.index];
            var text = cell ? cell.textContent.trim() : '';
            if (text !== '' && seen.indexOf(text) === -1) { seen.push(text); }
          });
          seen.sort();
          f.input.innerHTML = '';
          var any = document.createElement('option');
          any.value = '';
          any.text = s.any;
          f.input.appendChild(any);
          seen.forEach(function (value) {
            var option = document.createElement('option');
            option.value = value;
            option.text = value;
            f.input.appendChild(option);
          });
          // Only restore a selection that still exists; otherwise the control would display a
          // value the table can no longer produce, filtering everything away with no way back.
          f.input.value = seen.indexOf(previous) !== -1 ? previous : '';
        });
      }

      function apply(table) {
        var s = strings();
        var terms = (table.ctsyncFilterInputs || [])
            .map(function (f) {
              return { index: f.index, enumerable: f.enumerable,
                       value: f.input.value.trim().toLowerCase() };
            })
            .filter(function (f) { return f.value !== ''; });

        var rows = dataRows(table.tBodies[0]);
        var visible = 0;
        rows.forEach(function (tr) {
          var match = terms.every(function (t) {
            var cell = tr.cells[t.index];
            if (!cell) { return false; }
            var text = cell.textContent.trim().toLowerCase();
            // A picked option is an exact value, so match it exactly - a substring test would let
            // "XML" also match a hypothetical "XMLA". Typed text stays a substring search.
            return t.enumerable ? text === t.value : text.indexOf(t.value) !== -1;
          });
          tr.style.display = match ? '' : 'none';
          if (match) { visible++; }
        });

        var status = table.ctsyncFilterStatus;
        if (status) {
          status.hidden = terms.length === 0;
          // The no-matches message lives here rather than as a row in tbody, because core's
          // sortable treats every tbody row as data and would sort the message among the results.
          status.textContent = (terms.length > 0 && visible === 0 && rows.length > 0)
              ? s.noMatches
              : format(s.count, visible, rows.length);
        }
      }

      function init() {
        Array.prototype.forEach.call(document.querySelectorAll('table.ctsync-filterable'),
          function (table) {
            whenSortingWired(table, function () { wire(table); });
          });
      }

      // Called by whatever rebuilt a table body, so re-application does not depend on the
      // MutationObserver being delivered. The observer stays as a backstop for rebuilds this
      // plugin does not perform itself, but the pages that DO rebuild their own tables announce it
      // here: an explicit call is deterministic, and it is testable - the test harness this plugin
      // builds with delivers no MutationObserver callbacks at all, so the observer path cannot be
      // covered by a test at present (see TableFilterBehaviourTest).
      var refreshAll = function () {
        Array.prototype.forEach.call(document.querySelectorAll('table.ctsync-filterable'),
          function (table) {
            if (table.ctsyncFilterInputs) {
              syncEnumOptions(table);
              apply(table);
            }
          });
      };
      if (typeof window !== 'undefined') {
        window.ctsyncRefreshTableFilters = refreshAll;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  ]]></script>
</j:jelly>
