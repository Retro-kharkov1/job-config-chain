<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form" xmlns:jc="/lib/jobconfigchain">
  <!-- Manage Jenkins sub-page (hosting review): l:settings-subpage supplies the layout, the Manage Jenkins
       side panel when the user enables the new Manage Jenkins UI, and the page chrome. header="" suppresses its
       default title bar because this page renders its own l:app-bar below (title plus controls); width="wide" is
       honoured by newer core and ignored by older (the plugin CSS widens the container for those). noDefer keeps
       the body rendered inline so the page scripts and the Monaco loader run as before. -->
  <l:settings-subpage title="${%title}" header="" width="wide" noDefer="true">
      <st:bind var="proxy" value="${it}"/>

      <!-- CSP migration (see https://www.jenkins.io/doc/developer/security/csp/): this page's own
           inline <style>/<script> were extracted verbatim into index.css/index.js, sibling files
           to this index.jelly, loaded via st:adjunct (see the ctsyncRootStyle/RootScript adjuncts under
           io/jenkins/plugins/jobconfigchain/adjuncts/).
           Every former inline onXxx="..." attribute below is now wired in index.js via
           addEventListener; server-side values it needs (rootURL/urlName) ride on data-*
           attributes instead of being interpolated into script text. -->
      <st:adjunct includes="io.jenkins.plugins.jobconfigchain.adjuncts.ctsyncRootStyle"/>

      <div class="ctsync-hidden" id="ctsyncPageSeed" data-root-url="${rootURL}" data-url-name="${it.urlName}"/>

      <div class="ctsync-page">

      <l:app-bar title="${%title}"/>
      <p>${%intro}</p>

      <jc:confirmByNameBlock/>

      <j:if test="${it.flashDeletedKey != null}">
        <div class="jenkins-alert jenkins-alert-info">${%flash.deleted(it.flashDeletedKey)}</div>
      </j:if>
      <j:if test="${it.flashRestoredKey != null}">
        <div class="jenkins-alert jenkins-alert-info">${%flash.restored(it.flashRestoredKey)}</div>
      </j:if>
      <j:if test="${it.flashPurgedKey != null}">
        <div class="jenkins-alert jenkins-alert-info">${%flash.purged(it.flashPurgedKey)}</div>
      </j:if>

      <div id="purgeBlockedBanner" class="jenkins-alert jenkins-alert-danger ctsync-blocked-banner ctsync-hidden"/>

      <j:if test="${!it.deletedConfigSets.isEmpty()}">
        <div class="ctsync-btn-row help-sibling">
          <label>
            <input type="checkbox" id="showDeletedToggle"/>
            ${%showDeleted.label} (${it.deletedConfigSets.size()})
          </label>
          <f:helpLink url="/job-config-chain-help/showDeleted" featureName="${%showDeleted.label}"/>
        </div>
        <f:helpArea/>
      </j:if>

      <template id="ctsyncListStrings"
                data-purge-dialog-title="${%purge.dialogTitle}"
                data-purge-dialog-message="${%purge.dialogMessage}"
                data-purge-ok-label="${%purge.okLabel}"
                data-purge-blocked-intro="${%purge.blockedIntro}"
                data-job-row="${%deletedRow.jobRow}"
                data-name-reserved="${%newConfigSet.nameReserved}"/>

      <jc:tableToolsBlock/>
      <div id="commonConfigSetsTableWrap" class="ctsync-scroll-table">
        <table class="jenkins-table sortable ctsync-filterable ctsync-w-full">
          <thead>
            <tr>
              <th>${%column.name}</th>
              <th data-ctsync-filter="enum">${%column.type}</th>
              <th>${%column.activeVersion}</th>
              <th>${%column.changedBy}</th>
              <th data-ctsync-filter="enum">${%column.status}</th>
              <!-- data-sort-disable is required, not decorative: it is core's own marker for a
                   column that cannot be ordered by its content, and the filter block keys off it
                   to skip offering a filter over a column of buttons. TableFilterMarkupTest
                   enforces both. -->
              <th data-sort-disable="true">${%column.actions}</th>
            </tr>
          </thead>
          <tbody>
            <j:choose>
              <j:when test="${it.commonConfigSets.isEmpty()}">
                <tr class="ctsync-empty-state-row"><td colspan="6">${%emptyState.noConfigSets}</td></tr>
              </j:when>
              <j:otherwise>
                <j:forEach var="cs" items="${it.commonConfigSets}">
                  <tr>
                    <td>
                      <a href="${rootURL}/${it.urlName}/${cs.projectKey}/">${cs.projectKey}</a>
                    </td>
                    <td>${cs.contentType}</td>
                    <td>
                      <j:choose>
                        <j:when test="${cs.activeVersion != null}">v${cs.activeVersion.versionNumber}</j:when>
                        <j:otherwise>${%noActiveVersion}</j:otherwise>
                      </j:choose>
                    </td>
                    <td>
                      <j:choose>
                        <j:when test="${cs.activeVersion != null}">
                          ${cs.activeVersion.author}
                        </j:when>
                        <j:otherwise>&#8212;</j:otherwise>
                      </j:choose>
                    </td>
                    <td>${%status.live}</td>
                    <td/>
                  </tr>
                </j:forEach>
              </j:otherwise>
            </j:choose>
          </tbody>
        </table>
      </div>

      <!--
        Deleted rows live in a template, NOT hidden inside the tbody, and the toggle clones them in
        and takes them out again. A template's content is a separate document fragment, so neither
        core's sortable nor the filter block can see it until it is deliberately inserted.

        Hiding them in place with display:none instead would break three ways, all silently: the
        filter block rewrites style.display on every data row each time any filter changes, so the
        hidden rows would reappear on the first keystroke; its row count would include them; and it
        derives the Type column options from every row present, so the picker would offer types no
        visible row has.
      -->
      <template id="deletedRowsTemplate">
        <j:forEach var="cs" items="${it.deletedConfigSets}">
          <tr class="ctsync-row--deleted">
            <td>
              <a href="${rootURL}/${it.urlName}/${cs.projectKey}/">${cs.projectKey}</a>
            </td>
            <td>${cs.contentType}</td>
            <td>
              <j:choose>
                <j:when test="${cs.activeVersion != null}">v${cs.activeVersion.versionNumber}</j:when>
                <j:otherwise>${%noActiveVersion}</j:otherwise>
              </j:choose>
            </td>
            <td>${%deletedRow.deletedBy(cs.deletion.deletedBy)}</td>
            <td>${%status.deleted}</td>
            <td>
              <div class="ctsync-btn-row ctsync-btn-row--flush">
                <button type="button" class="jenkins-button ctsync-restore-btn"
                        data-project-key="${cs.projectKey}" title="${%restore.title}"
                        >${%restore.label}</button>
                <button type="button" class="jenkins-button jenkins-button--destructive ctsync-purge-btn"
                        data-project-key="${cs.projectKey}" title="${%purge.title}"
                        ><l:icon src="symbol-trash" class="icon-sm"/> ${%purge.label}</button>
              </div>
            </td>
          </tr>
        </j:forEach>
      </template>

      <!-- New Config Set (owner-directed layout redesign, 2026-09-04): heading rendered by
           f:section's own title bar (matching the "heading lives inside the frame" convention
           already established by every f:section on CommonConfigSetPage/EnvConfigSetPage), not a
           separate h2 sitting above it — this keeps a single visual language for "framed section
           with a heading" across all three pages instead of inventing a second pattern here. -->
      <f:section title="${%newConfigSet.heading}">
        <p>${%newConfigSet.introText}</p>
        <div class="ctsync-newconfig-form">
          <!-- Visible label instead of a placeholder-only input (accessibility convention already
               used elsewhere in this plugin — e.g. the Secrets-manifest "Add / update secret"
               f:entry pairs a real title with its path input rather than relying on placeholder
               text alone); the placeholder now only carries the example format, exactly like that
               same secret-path input's own "database.password" placeholder. -->
          <f:entry title="${%newConfigSet.projectKeyLabel}"
                   help="/job-config-chain-help/newConfigKey">
            <input type="text" name="projectKey" id="newProjectKey" placeholder="my-app" class="jenkins-input"/>
          </f:entry>
          <div>
            <div class="help-sibling ctsync-help-row">
              <label class="ctsync-content-type-label">${%contentType.label}</label>
              <f:helpLink url="/job-config-chain-help/contentType" featureName="${%contentType.label}"/>
            </div>
            <f:helpArea/>
            <div class="ctsync-content-type-hint"><l:icon src="symbol-information-circle" class="icon-sm"/> ${%contentType.chooseOnceHelp}</div>
            <div class="ctsync-content-type-radios" id="newContentTypeGroup">
              <label><input type="radio" name="newContentTypeRadio" value="JSON" id="newContentTypeJson" checked="checked"/> JSON</label>
              <label><input type="radio" name="newContentTypeRadio" value="XML" id="newContentTypeXml"/> XML</label>
              <label><input type="radio" name="newContentTypeRadio" value="YAML" id="newContentTypeYaml"/> YAML</label>
            </div>
          </div>
        </div>
      </f:section>

      <!-- Create button lives OUTSIDE/below the bordered card on purpose — see the
           ".ctsync-newconfig-form" CSS comment above for the reasoning. data-root-url/data-url-name
           carry what the removed inline onclick="..." used to read straight out of ${rootURL}/
           ${it.urlName} — see index.js's newConfigSetCreate wiring. -->
      <div class="ctsync-btn-row ctsync-btn-row--right">
        <button type="button" id="newConfigSetCreate" class="jenkins-button jenkins-button--primary"
                title="${%newConfigSet.buttonTitle}"
                data-root-url="${rootURL}" data-url-name="${it.urlName}"
                >${%newConfigSet.buttonLabel}</button>
      </div>

      </div>

      <!-- HTML5 parsing note: <script> is never a void element - a self-closed <script .../>
           is NOT closed by a real browser's HTML parser, which instead keeps consuming markup
           as this element's (unexecuted, since src is set) text content until it finds the next
           literal </script> anywhere later in the document, silently swallowing whatever real
           HTML sits in between. Every script tag here must have an explicit closing tag. -->
      <st:adjunct includes="io.jenkins.plugins.jobconfigchain.adjuncts.ctsyncRootScript"/>
  </l:settings-subpage>
</j:jelly>
