<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="${%title}">
    <l:main-panel>
      <st:bind var="proxy" value="${it}"/>
      <style>
        /* Scoped to this page only (never a global Jenkins style override) — same
           ".ctsync-page" scoping + bordered jenkins-section card convention already applied to
           CommonConfigSetPage/EnvConfigSetPage (owner-directed consistency pass, 2026-09-04). This
           page previously had no f:section on it at all — this is the first one, brought in
           purely to frame "New Config Set" the same way the other two pages frame their own
           sections, not a general redesign of this page. */
        .ctsync-page .jenkins-button { margin: 4px 6px 4px 0; }
        .ctsync-btn-row { margin: 12px 0 0; }
        .ctsync-btn-row--right { text-align: right; }
        /* Opacity alone is not an accessible signal, which is why the Status column carries the
           word as well - this only keeps the eye on the live inventory. */
        .ctsync-row--deleted { opacity: 0.62; }
        .ctsync-row--deleted td:first-child a { text-decoration: line-through; }
        /* Bordered-card framing for f:section — identical rule, identical reasoning, and the
           identical (already-fixed) color token as CommonConfigSetPage/EnvConfigSetPage's own
           "Bordered-card framing for f:section" comment: Jenkins core's own jenkins-section only
           draws a top rule via --panel-border-color, which resolves to an all-but-invisible
           #f4f4f8 on a white page background (confirmed live, then fixed, on those two pages
           earlier the same day) — --table-border-color is the token already proven to render as a
           clearly visible line elsewhere on this plugin's own pages, so it is reused here rather
           than reintroducing the same invisible-border mistake a third time. */
        .ctsync-page .jenkins-section,
        .ctsync-page .jenkins-section:first-of-type,
        .ctsync-page .jenkins-section:last-child {
          border: 1px solid var(--table-border-color, #ddd);
          border-radius: var(--form-input-border-radius, 6px);
          padding: 1.25rem;
          margin: 28px 0 0;
        }
/* Section headings (owner report, 2026-09-05): Jenkins core renders jenkins-section__title
           at normal weight, so inside a bordered card the section's topic carried no more visual
           weight than the body text under it and the cards read as undifferentiated blocks. Bolded
           and slightly enlarged, with breathing room below it, so each card's topic reads as a
           heading at a glance. Scoped to this page's own container — never a global core override. */
        .ctsync-page .jenkins-section__title {
          font-weight: 700;
          font-size: 1.15em;
          margin-bottom: 14px;
        }
        /* New Config Set form (owner report, 2026-09-04): the projectKey input, content-type
           radio group and its info hint were previously one cramped inline row (".ctsync-inline-form",
           now removed) — stacked into a column instead, capped at a comfortable reading width
           rather than stretching the full page width on desktop. The Create button is deliberately
           OUTSIDE this rule/the frame (see the markup below) — it lives in its own ".ctsync-btn-row"
           beneath the bordered card, mirroring how Jenkins core itself typically separates an
           input-group card from its primary action (e.g. a job configuration page's own
           Save/Apply row sitting below, not inside, its settings fieldsets). */
        .ctsync-newconfig-form { display: flex; flex-direction: column; gap: 14px; max-width: 480px; }
        .ctsync-newconfig-form .setting-input { width: 100% !important; }
        /* Content-type group gets its own micro-label now that it is a stacked block in its own
           right rather than an inline afterthought — same visual weight/typography as the
           "Content type:" label CommonConfigSetPage/EnvConfigSetPage already use for their own
           (locked-after-first-save) content-type rows, reusing the same ${%contentType.label}
           bundle key so the wording stays identical everywhere it appears in this plugin. The info
           hint sits directly below that label and ABOVE the radios themselves (owner report,
           2026-09-04) — read order becomes label, then "why this choice matters", then the actual
           choice, instead of the hint trailing after the radios where it previously read as a
           squeezed-in afterthought. */
        .ctsync-content-type-label { font-weight: 600; display: block; margin-bottom: 4px; }
        .ctsync-content-type-hint { color: #666; margin-bottom: 8px; }
        .ctsync-content-type-radios label { margin-right: 12px; }
        /* Table-scroll behavior (same plan as CommonConfigSetPage/EnvConfigSetPage/SharedBlocks):
           contain a long table's growth so page buttons/sections below it stay reachable, without
           requiring the whole page to scroll. Applied to the wrapper div, never the table element
           itself — overflow on a table element directly has known sticky-header/border quirks. */
        /* Contained-scrollbar fix (ux-ui-designer spec, 2026-09-11): the wrapper div — not the
           table — owns overflow-y:auto and is therefore what the browser paints the native
           scrollbar against. Previously only the inner table.jenkins-table had a radius, so the
           scrollbar rendered as a square-edged strip outside the table's rounded frame (confirmed
           live). Border+radius now live on this wrapper itself; overflow-x:hidden is required
           alongside overflow-y:auto so the box reliably clips its own scrollbar to the radius in
           all evergreen browsers, not just Chrome. */
        .ctsync-scroll-table {
          max-height: 50vh;
          overflow-y: auto;
          overflow-x: hidden;
          width: fit-content;
          max-width: 100%;
          border: 1px solid var(--table-border-color, #ddd);
          border-radius: var(--form-input-border-radius, 6px);
          /* Phantom-overflow fix (owner report, 2026-09-11): explicit border-box, never relying on
             inherited box-sizing — the wrapper's own border (added by the Fix-A change above)
             combined with a content-box ancestor could otherwise make scrollHeight compute a few
             px larger than clientHeight even for a single-row table, spuriously flirting with
             overflow:auto's scrollbar for content that doesn't actually overflow. */
          box-sizing: border-box;
        }
        /* The inner table's own border/radius is now redundant (and would visually double up
           against the wrapper's frame) — stripped here. */
        .ctsync-scroll-table table.jenkins-table {
          border: none;
          border-radius: 0;
          margin: 0;
          border-spacing: 0;
        }
        .ctsync-scroll-table {
          scrollbar-width: thin;
          scrollbar-color: var(--text-color-secondary, #8c8c8c) transparent;
        }
        .ctsync-scroll-table::-webkit-scrollbar { width: 10px; }
        .ctsync-scroll-table::-webkit-scrollbar-track { background: transparent; }
        .ctsync-scroll-table::-webkit-scrollbar-thumb {
          background-color: var(--text-color-secondary, #8c8c8c);
          border-radius: var(--form-input-border-radius, 6px);
          border: 2px solid var(--table-background, #fff);
        }
        .ctsync-scroll-table::-webkit-scrollbar-thumb:hover {
          background-color: var(--table-hover-color, #f0f6ff);
        }
        /* Sticky header keeps the column labels visible while only the body rows scroll inside
           this fixed-height wrapper; position: sticky targets the header cells directly (not the
           header row/group element) for the most reliable cross-browser support, since this
           wrapper div is each header cell's own nearest scrolling ancestor. */
        .ctsync-scroll-table thead th {
          position: sticky;
          top: 0;
          z-index: 1;
          background-color: var(--table-background, #fff);
          /* Phantom-scrollbar fix (owner report, 2026-09-11) — see CommonConfigSetPage's
             identical comment: box-shadow replaces border-bottom to avoid the sticky-cell
             border/content-height double-counting quirk. */
          box-shadow: 0 2px 0 0 var(--table-border-color, #ddd);
        }
        /* Empty-state row (ux-ui-designer correction, 2026-09-11): a zero-row table keeps its own
           header and renders ONE spanning row in its body instead of the whole table being
           replaced by a separate placeholder div (the original design lost the column header,
           e.g. "Name | Type | ..." entirely on an empty list — confirmed live). Plain cell
           styling, no border of its own — it lives inside the already-framed .ctsync-scroll-table. */
        .ctsync-empty-state-row td {
          padding: 32px 16px;
          text-align: center;
          color: var(--text-color-secondary, #666);
          font-size: 0.95em;
          border: none;
        }
      </style>
      <div class="ctsync-page">

      <h1>${%title}</h1>
      <p>
        Global (common) Config Sets. Click a row to open its editor; open a project's env layer
        from that project's page.
      </p>

      <st:include class="${it.sharedBlocksClass}" page="confirmByNameBlock.jelly" it="${it}"/>

      <j:if test="${it.flashDeletedKey != null}">
        <div class="alert alert-info">${%flash.deleted(it.flashDeletedKey)}</div>
      </j:if>
      <j:if test="${it.flashRestoredKey != null}">
        <div class="alert alert-info">${%flash.restored(it.flashRestoredKey)}</div>
      </j:if>
      <j:if test="${it.flashPurgedKey != null}">
        <div class="alert alert-info">${%flash.purged(it.flashPurgedKey)}</div>
      </j:if>

      <div id="purgeBlockedBanner" class="alert alert-danger ctsync-blocked-banner"
           style="display:none"/>

      <j:if test="${!it.deletedConfigSets.isEmpty()}">
        <div class="ctsync-btn-row">
          <label>
            <input type="checkbox" id="showDeletedToggle" onclick="toggleDeletedRows(this.checked);"/>
            ${%showDeleted.label} (${it.deletedConfigSets.size()})
          </label>
        </div>
      </j:if>

      <template id="ctsyncListStrings"
                data-purge-dialog-title="${%purge.dialogTitle}"
                data-purge-dialog-message="${%purge.dialogMessage}"
                data-purge-ok-label="${%purge.okLabel}"
                data-purge-blocked-intro="${%purge.blockedIntro}"
                data-job-row="${%deletedRow.jobRow}"
                data-name-reserved="${%newConfigSet.nameReserved}"/>

      <st:include class="${it.sharedBlocksClass}" page="tableToolsBlock.jelly" it="${it}"/>
      <div id="commonConfigSetsTableWrap" class="ctsync-scroll-table">
        <table class="jenkins-table sortable ctsync-filterable" style="width:100%">
          <thead>
            <tr>
              <th>${%column.name}</th>
              <th data-ctsync-filter="enum">${%column.type}</th>
              <th>${%column.activeVersion}</th>
              <th>${%column.changedBy}</th>
              <th data-ctsync-filter="enum">${%column.status}</th>
              <!-- data-sort-disable is required, not decorative: it is core's own marker for a
                   column that cannot be ordered by its content, and the filter block keys off it
                   to skip offering a filter over a column of buttons. TableFilterMarkupTest
                   enforces both. -->
              <th data-sort-disable="true">${%column.actions}</th>
            </tr>
          </thead>
          <tbody>
            <j:choose>
              <j:when test="${it.commonConfigSets.isEmpty()}">
                <tr class="ctsync-empty-state-row"><td colspan="6">${%emptyState.noConfigSets}</td></tr>
              </j:when>
              <j:otherwise>
                <j:forEach var="cs" items="${it.commonConfigSets}">
                  <tr>
                    <td>
                      <a href="${rootURL}/${it.urlName}/${cs.projectKey}/">${cs.projectKey}</a>
                    </td>
                    <td>${cs.contentType}</td>
                    <td>
                      <j:choose>
                        <j:when test="${cs.activeVersion != null}">v${cs.activeVersion.versionNumber}</j:when>
                        <j:otherwise>${%noActiveVersion}</j:otherwise>
                      </j:choose>
                    </td>
                    <td>
                      <j:choose>
                        <j:when test="${cs.activeVersion != null}">
                          ${cs.activeVersion.author}
                        </j:when>
                        <j:otherwise>&#8212;</j:otherwise>
                      </j:choose>
                    </td>
                    <td>${%status.live}</td>
                    <td/>
                  </tr>
                </j:forEach>
              </j:otherwise>
            </j:choose>
          </tbody>
        </table>
      </div>

      <!--
        Deleted rows live in a template, NOT hidden inside the tbody, and the toggle clones them in
        and takes them out again. A template's content is a separate document fragment, so neither
        core's sortable nor the filter block can see it until it is deliberately inserted.

        Hiding them in place with display:none instead would break three ways, all silently: the
        filter block rewrites style.display on every data row each time any filter changes, so the
        hidden rows would reappear on the first keystroke; its row count would include them; and it
        derives the Type column options from every row present, so the picker would offer types no
        visible row has.
      -->
      <template id="deletedRowsTemplate">
        <j:forEach var="cs" items="${it.deletedConfigSets}">
          <tr class="ctsync-row--deleted">
            <td>
              <a href="${rootURL}/${it.urlName}/${cs.projectKey}/">${cs.projectKey}</a>
            </td>
            <td>${cs.contentType}</td>
            <td>
              <j:choose>
                <j:when test="${cs.activeVersion != null}">v${cs.activeVersion.versionNumber}</j:when>
                <j:otherwise>${%noActiveVersion}</j:otherwise>
              </j:choose>
            </td>
            <td>${%deletedRow.deletedBy(cs.deletion.deletedBy)}</td>
            <td>${%status.deleted}</td>
            <td>
              <button type="button" class="jenkins-button ctsync-restore-btn"
                      data-project-key="${cs.projectKey}" title="${%restore.title}"
                      onclick="restoreDeleted(this.getAttribute('data-project-key'));"
                      >${%restore.label}</button>
              <button type="button" class="jenkins-button jenkins-button--destructive ctsync-purge-btn"
                      data-project-key="${cs.projectKey}" title="${%purge.title}"
                      onclick="purgeDeleted(this.getAttribute('data-project-key'));"
                      >&#128465; ${%purge.label}</button>
            </td>
          </tr>
        </j:forEach>
      </template>

      <!-- New Config Set (owner-directed layout redesign, 2026-09-04): heading rendered by
           f:section's own title bar (matching the "heading lives inside the frame" convention
           already established by every f:section on CommonConfigSetPage/EnvConfigSetPage), not a
           separate h2 sitting above it — this keeps a single visual language for "framed section
           with a heading" across all three pages instead of inventing a second pattern here. -->
      <f:section title="${%newConfigSet.heading}">
        <p>${%newConfigSet.introText}</p>
        <div class="ctsync-newconfig-form">
          <!-- Visible label instead of a placeholder-only input (accessibility convention already
               used elsewhere in this plugin — e.g. the Secrets-manifest "Add / update secret"
               f:entry pairs a real title with its path input rather than relying on placeholder
               text alone); the placeholder now only carries the example format, exactly like that
               same secret-path input's own "database.password" placeholder. -->
          <f:entry title="${%newConfigSet.projectKeyLabel}">
            <input type="text" name="projectKey" id="newProjectKey" placeholder="my-app" class="setting-input"/>
          </f:entry>
          <div>
            <label class="ctsync-content-type-label">${%contentType.label}</label>
            <div class="ctsync-content-type-hint">&#9432; ${%contentType.chooseOnceHelp}</div>
            <div class="ctsync-content-type-radios" id="newContentTypeGroup">
              <label><input type="radio" name="newContentTypeRadio" value="JSON" id="newContentTypeJson" checked="checked"/> JSON</label>
              <label><input type="radio" name="newContentTypeRadio" value="XML" id="newContentTypeXml"/> XML</label>
              <label><input type="radio" name="newContentTypeRadio" value="YAML" id="newContentTypeYaml"/> YAML</label>
            </div>
          </div>
        </div>
      </f:section>

      <!-- Create button lives OUTSIDE/below the bordered card on purpose — see the
           ".ctsync-newconfig-form" CSS comment above for the reasoning. -->
      <div class="ctsync-btn-row ctsync-btn-row--right">
        <button type="button" id="newConfigSetCreate" class="jenkins-button jenkins-button--primary"
                title="${%newConfigSet.buttonTitle}"
                onclick="var k = document.getElementById('newProjectKey').value; var t = document.querySelector('input[name=newContentTypeRadio]:checked').value; window.location.href = '${rootURL}/${it.urlName}/' + encodeURIComponent(k) + '/?contentType=' + encodeURIComponent(t);">${%newConfigSet.buttonLabel}</button>
      </div>

      </div>

      <script>
        // Phantom-scroll reconciliation (owner report, 2026-09-11): see CommonConfigSetPage/index.jelly's
        // identical comment/helper for the full rationale.
        // ---- Deleted Config Sets ---------------------------------------------------------------
        // The rows are cloned out of an inert template into the tbody and removed again, rather
        // than hidden in place. See the template's own comment for why - in short, the filter block
        // rewrites display on every data row, counts them, and derives the Type options from them,
        // so a row hidden inside the table is not actually hidden for long.

        function listStrings() {
          var tpl = document.getElementById('ctsyncListStrings');
          return tpl ? tpl.dataset : {};
        }

        function announceRowsChanged() {
          // The published contract of the filter block: whoever rebuilds a table body says so, and
          // the block re-derives its enum options and re-applies any active filter. Without this a
          // filter would keep matching the rows it was given and quietly ignore the new ones.
          if (typeof window !== 'undefined'
              &amp;&amp; typeof window.ctsyncRefreshTableFilters === 'function') {
            window.ctsyncRefreshTableFilters();
          }
        }

        function toggleDeletedRows(show) {
          var table = document.querySelector('table.ctsync-filterable');
          var tbody = table.tBodies[0];
          if (show) {
            var template = document.getElementById('deletedRowsTemplate');
            var rows = template.content.querySelectorAll('tr');
            for (var i = 0; i &lt; rows.length; i++) {
              tbody.appendChild(document.importNode(rows[i], true));
            }
          } else {
            var present = tbody.querySelectorAll('tr.ctsync-row--deleted');
            for (var j = 0; j &lt; present.length; j++) {
              present[j].parentNode.removeChild(present[j]);
            }
          }
          announceRowsChanged();
        }

        function lifecycleButtons(projectKey, disabled) {
          var buttons = document.querySelectorAll('[data-project-key="' + projectKey + '"]');
          for (var i = 0; i &lt; buttons.length; i++) {
            buttons[i].disabled = disabled;
          }
        }

        function restoreDeleted(projectKey) {
          // No typed-name confirmation: restoring is fully reversible, and asking for the same
          // ceremony as a purge would train the operator to type through both without reading.
          lifecycleButtons(projectKey, true);
          proxy.restoreConfigSet(JSON.stringify({ projectKey: projectKey }), function (t) {
            var r = t.responseObject();
            if (!r.ok) {
              lifecycleButtons(projectKey, false);
              window.ctsyncNotify(r.error, true);
              return;
            }
            window.location.href = '${rootURL}/${it.urlName}/?restored='
                + encodeURIComponent(projectKey);
          });
        }

        function purgeJobItems(entries) {
          var items = [];
          for (var i = 0; i &lt; entries.length; i++) {
            items.push({
              text: window.ctsyncFormatMessage(listStrings().jobRow, entries[i].fullName,
                  entries[i].versions.join(', ')),
              url: entries[i].url
            });
          }
          return items;
        }

        function purgeDeleted(projectKey) {
          var d = listStrings();
          lifecycleButtons(projectKey, true);
          window.ctsyncHideBlocked('purgeBlockedBanner');
          proxy.purgePreflight(JSON.stringify({ projectKey: projectKey }), function (t) {
            lifecycleButtons(projectKey, false);
            var r = t.responseObject();
            if (r.blocked) {
              // Purge is refused for ANY reference, including one only an old job version names:
              // there is no restore afterwards to repair a rollback this would have broken.
              window.ctsyncShowBlocked('purgeBlockedBanner',
                  window.ctsyncFormatMessage(d.purgeDialogTitle, projectKey),
                  [{ intro: d.purgeBlockedIntro,
                     items: purgeJobItems(r.activeJobs.concat(r.historicalJobs)) }]);
              return;
            }
            if (!r.ok) { window.ctsyncNotify(r.error, true); return; }
            window.ctsyncConfirmByName({
              expectedName: projectKey,
              title: window.ctsyncFormatMessage(d.purgeDialogTitle, projectKey),
              message: window.ctsyncFormatMessage(d.purgeDialogMessage, projectKey),
              okLabel: d.purgeOkLabel,
              onConfirm: function (typed) {
                proxy.purgeConfigSet(JSON.stringify({ projectKey: projectKey, confirmName: typed }),
                    function (t2) {
                      var r2 = t2.responseObject();
                      if (!r2.ok) { window.ctsyncNotify(r2.error, true); return; }
                      window.location.href = '${rootURL}/${it.urlName}/?purged='
                          + encodeURIComponent(projectKey);
                    });
              }
            });
          });
        }

        function reconcilePhantomScroll(wrapEl) {
          if (!wrapEl) { return; }
          var realOverflow = wrapEl.scrollHeight - wrapEl.clientHeight;
          wrapEl.style.overflowY = (realOverflow > 4) ? 'auto' : 'hidden';
        }

        function reconcilePhantomScrollSoon(wrapEl) {
          reconcilePhantomScroll(wrapEl);
          // Nashorn-based JS-engine unit tests (ConfigTemplatesUiTest) run this same script without
          // a setTimeout global — guard it so those tests keep exercising the immediate reconcile
          // pass without needing a timer shim.
          if (typeof setTimeout === 'function') {
            setTimeout(function () { reconcilePhantomScroll(wrapEl); }, 50);
          }
        }

        reconcilePhantomScrollSoon(document.getElementById('commonConfigSetsTableWrap'));
      </script>
    </l:main-panel>
  </l:layout>
</j:jelly>
