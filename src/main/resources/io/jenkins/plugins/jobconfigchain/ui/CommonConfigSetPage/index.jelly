<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form" xmlns:jc="/lib/jobconfigchain">
  <l:layout title="${it.displayName}">
    <l:main-panel>
      <st:bind var="proxy" value="${it}"/>

      <!-- CSP migration (see https://www.jenkins.io/doc/developer/security/csp/): this page's own
           inline <style>/<script> were extracted verbatim into index.css/index.js, sibling files
           to this index.jelly, loaded via st:adjunct (see the ctsyncCommonStyle/CommonScript adjuncts under
           io/jenkins/plugins/jobconfigchain/adjuncts/).
           Server-side values index.js needs (previously interpolated via ${...}/<j:out> straight
           into the script text) now ride on #ctsyncCommonSeed's data-* attributes instead. -->
      <st:adjunct includes="io.jenkins.plugins.jobconfigchain.adjuncts.ctsyncCommonStyle"/>

      <div class="ctsync-hidden" id="ctsyncCommonSeed"
           data-editor-seed="${it.editorSeedJsonForScript}"
           data-project-key="${it.projectKey}"
           data-root-url="${rootURL}"
           data-monaco-base="${rootURL}/plugin/${it.pluginShortName}/monaco/vs"
           data-empty-versions="${%emptyState.noVersions}"
           data-empty-secrets="${%emptyState.noSecrets}"
           data-js-malformed-xml="${%js.malformedXml}"
           data-js-malformed-yaml="${%js.malformedYaml}"
           data-js-locked="${%contentType.locked}"
           data-js-saved="${%js.saved}"
           data-js-saved-activated="${%js.savedActivated}"
           data-js-comparing="${%js.comparing}"/>

      <div class="ctsync-page">

      <jc:iconsBlock/>
      <jc:confirmByNameBlock/>

      <l:app-bar title="${it.displayName}">
        <!-- id added (bug fix, 2026-09-28): a first Save's in-place-update response (see
             index.js's applyConfigSetNowExists) builds and inserts deleteConfigSetBtn into this
             row without a page reload. The button itself stays absent from the DOM entirely
             (never merely hidden) while !it.exists, matching the pre-existing, deliberate
             "there is nothing to delete before the first save" contract
             (theDeleteButtonRendersOnALiveConfigSetAndNotOnAnAbsentOne) — it is BUILT, not
             revealed, exactly like applyContentTypeLocked below already does for the content-type
             picker's own locked/unlocked swap. -->
        <div class="ctsync-btn-row ctsync-btn-row--flush" id="pageHeaderBtnRow">
          <j:choose>
            <j:when test="${it.deleted}">
              <button type="button" id="restoreConfigSetBtn" class="jenkins-button"
                      title="${%restore.title}"
                      >${%restore.label}</button>
              <button type="button" id="purgeConfigSetBtn"
                      class="jenkins-button jenkins-button--destructive"
                      title="${%purge.title}"
                      ><l:icon src="symbol-trash" class="icon-sm"/> ${%purge.label}</button>
            </j:when>
            <j:when test="${it.exists}">
              <button type="button" id="deleteConfigSetBtn"
                      class="jenkins-button jenkins-button--destructive"
                      title="${%deleteConfigSet.title}"
                      ><l:icon src="symbol-trash" class="icon-sm"/> ${%deleteConfigSet.label}</button>
            </j:when>
          </j:choose>
        </div>
      </l:app-bar>

      <div id="deleteBlockedBanner" class="jenkins-alert jenkins-alert-danger ctsync-blocked-banner ctsync-hidden"/>

      <!-- Localized text for the script-built dialogs. Jelly cannot substitute ${%key} inside a
           script block, so it rides on data-* here, the pattern the row templates already use. -->
      <template id="ctsyncLifecycleStrings"
                data-delete-dialog-title="${%deleteConfigSet.dialogTitle}"
                data-delete-dialog-message="${%deleteConfigSet.dialogMessage}"
                data-delete-ok-label="${%deleteConfigSet.okLabel}"
                data-blocked-intro="${%deleteConfigSet.blockedIntro}"
                data-historical-note="${%deleteConfigSet.historicalNote}"
                data-job-row="${%deleteConfigSet.jobRow}"
                data-purge-dialog-title="${%purge.dialogTitle}"
                data-purge-dialog-message="${%purge.dialogMessage}"
                data-purge-ok-label="${%purge.okLabel}"
                data-purge-blocked-intro="${%purge.blockedIntro}"/>

      <!-- In-place-update template (bug fix, 2026-09-28): applyConfigSetNowExists clones this to
           build deleteConfigSetBtn the first time a Save makes it.exists true, instead of
           location.reload()-ing the whole page — same technique historyRowTemplate/
           secretRowTemplate already use below, so the button's localized label/title/icon are
           correctly rendered once by Jelly rather than re-implemented in JS (which would also
           have to fight JS-string-literal encoding of the wastebasket icon for no benefit). -->
      <template id="deleteConfigSetBtnTemplate">
        <button type="button" id="deleteConfigSetBtn"
                class="jenkins-button jenkins-button--destructive"
                title="${%deleteConfigSet.title}"><l:icon src="symbol-trash" class="icon-sm"/> ${%deleteConfigSet.label}</button>
      </template>

      <j:choose>
        <j:when test="${it.deleted}">
          <!-- Never the "does not exist yet - Save creates it" notice below: a deleted Config Set
               rendering as a blank new one is exactly the invitation to clobber an archive that
               reserving the name exists to prevent. -->
          <div class="jenkins-alert jenkins-alert-warning">
            ${%deletedState.banner(it.deletion.deletedBy)}
            <span class="ctsync-created-cell" data-epoch="${it.deletion.deletedAtEpochMillis}"
                  >${it.deletion.deletedAtEpochMillis}</span>
            ${%deletedState.editingDisabled}
          </div>
        </j:when>
        <j:when test="${!it.exists}">
          <!-- Bug fix (2026-09-28): id added so the first Save's in-place-update response (see
               index.js's saveClicked) can hide this banner without a page reload. -->
          <div id="notExistYetBanner" class="jenkins-alert jenkins-alert-info">${%notExistYet}</div>
        </j:when>
      </j:choose>

      <div id="secretsManifestDetails">
      <f:section title="${%secretsManifest.heading}">
        <p>${%secretsManifest.intro('__SECRET__')}</p>
        <jc:tableToolsBlock/>
        <div id="secretsManifestTableWrap" class="ctsync-scroll-table">
          <table class="jenkins-table sortable ctsync-filterable ctsync-w-full">
            <thead><tr><th>${%column.dottedPath}</th><th>${%column.credential}</th><th data-sort-disable="true"/></tr></thead>
            <tbody id="secretsManifestTbody">
              <j:choose>
                <j:when test="${it.exists and !it.configSet.secretsManifest.isEmpty()}">
                  <j:forEach var="entry" items="${it.configSet.secretsManifest.entrySet()}">
                    <tr>
                      <td>${entry.key}</td>
                      <td>${entry.value}</td>
                      <td>
                        <!-- CSP migration: onclick removed — index.js wires this via event
                             delegation, keyed off data-secret-path. -->
                        <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn"
                                data-secret-path="${entry.key}"
                                title="${%removeSecret.title}"><l:icon src="symbol-trash" class="icon-sm"/> ${%removeSecret.label}</button>
                      </td>
                    </tr>
                  </j:forEach>
                </j:when>
                <j:otherwise>
                  <tr class="ctsync-empty-state-row"><td colspan="3">${%emptyState.noSecrets}</td></tr>
                </j:otherwise>
              </j:choose>
            </tbody>
          </table>
        </div>
        <!-- In-place-update template (2026-09-02): addSecret/removeSecret's AJAX responses re-render
             this tbody client-side from JSON instead of location.reload()-ing the whole page. The
             template's own markup carries the correctly-localized static label/title text (rendered
             once by Jelly); JS only ever fills in the per-row dynamic path/credential values and
             wires the click handler — see renderSecretsManifestRows/buildSecretRowElement below. -->
        <template id="secretRowTemplate" data-remove-title="${%removeSecret.title}">
          <tr>
            <td class="js-secret-path"/>
            <td class="js-secret-cred"/>
            <td>
              <button type="button" class="jenkins-button jenkins-button--destructive ctsync-remove-secret-btn">
                <l:icon src="symbol-trash" class="icon-sm"/> ${%removeSecret.label}</button>
            </td>
          </tr>
        </template>
        <f:entry title="${%addSecret.entryTitle}"
                 help="/job-config-chain-help/secretBinding">
          <div class="ctsync-secret-form">
            <div class="ctsync-secret-form-fields">
              <input class="jenkins-input ctsync-secret-path-input" type="text" id="secretPath" placeholder="database.password"/>
              <div class="jenkins-select">
                <select class="jenkins-select__input" id="secretCredentialId">
                  <j:forEach var="cid" items="${it.availableCredentialIds}">
                    <option value="${cid}">${cid}</option>
                  </j:forEach>
                </select>
              </div>
            </div>
            <button type="button" id="addSecretBtn" class="jenkins-button"
                    title="${%bindCredential.title}">${%bindCredential.label}</button>
          </div>
        </f:entry>
      </f:section>
      </div>

      <div id="versionHistoryDetails">
      <f:section title="${%versionHistory.heading}">
        <p>${%versionHistory.hint}</p>
        <div id="versionHistoryTableWrap" class="ctsync-scroll-table">
          <table class="jenkins-table ctsync-history-table sortable ctsync-filterable ctsync-w-full">
            <thead><tr><th>${%column.version}</th><th>${%column.created}</th><th>${%column.createdBy}</th><th>${%column.note}</th><th data-ctsync-filter="enum">${%column.active}</th><th data-sort-disable="true">${%column.actions}</th></tr></thead>
            <tbody id="versionHistoryTbody">
              <j:if test="${it.versions.isEmpty()}">
                <tr class="ctsync-empty-state-row"><td colspan="6">${%emptyState.noVersions}</td></tr>
              </j:if>
              <!-- CSP migration: onclick/onkeydown removed from the row, onclick removed from the
                   Activate button — index.js wires both via event delegation on this tbody, keyed
                   off data-version-number. -->
              <j:forEach var="v" items="${it.versions}">
                <tr id="historyRow-${v.versionNumber}" class="ctsync-history-row"
                    data-version-number="${v.versionNumber}"
                    tabindex="0" role="button">
                  <td data-th="${%column.version}">v${v.versionNumber}</td>
                  <td data-th="${%column.created}" class="ctsync-created-cell" data-epoch="${v.timestampEpochMillis}">${v.timestampEpochMillis}</td>
                  <td data-th="${%column.createdBy}">${v.author}</td>
                  <td data-th="${%column.note}">${v.note}</td>
                  <td data-th="${%column.active}">
                    <j:if test="${it.activeVersion != null and it.activeVersion.versionNumber == v.versionNumber}">
                      <span class="ctsync-icon-text"><l:icon src="symbol-checkmark-circle plugin-ionicons-api" class="icon-sm"/> ${%activeStatus}</span>
                    </j:if>
                  </td>
                  <td data-th="${%column.actions}">
                    <j:choose>
                      <j:when test="${it.activeVersion != null and it.activeVersion.versionNumber == v.versionNumber}">
                        <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn"
                                disabled="disabled" data-always-disabled="true"
                                title="${%activate.alreadyActiveTitle}">${%activate.label}</button>
                      </j:when>
                      <j:otherwise>
                        <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn"
                                data-version-number="${v.versionNumber}"
                                title="${%activate.title(v.versionNumber)}">${%activate.label}</button>
                      </j:otherwise>
                    </j:choose>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </div>
        <!-- In-place-update template (2026-09-02): jsSave/activateVersion's AJAX responses re-render
             this tbody client-side from JSON instead of location.reload()-ing the whole page — see
             renderVersionHistoryRows/buildHistoryRowElement below. Static localized label/title text
             (the "Activate" button caption, the "active" badge word, the "already active" title) is
             stashed on this template (rendered once by Jelly) rather than re-implemented in JS. -->
        <template id="historyRowTemplate"
                  data-active-label="${%activeStatus}"
                  data-already-active-title="${%activate.alreadyActiveTitle}"
                  data-activate-title="${%activate.title}">
          <tr class="ctsync-history-row" tabindex="0" role="button">
            <td data-th="${%column.version}" class="js-version"/>
            <td data-th="${%column.created}" class="js-created"/>
            <td data-th="${%column.createdBy}" class="js-createdBy"/>
            <td data-th="${%column.note}" class="js-note"/>
            <td data-th="${%column.active}" class="js-activeBadge"/>
            <td data-th="${%column.actions}">
              <button type="button" class="jenkins-button jenkins-button--primary ctsync-activate-btn js-activate-btn">
                ${%activate.label}</button>
            </td>
          </tr>
        </template>
      </f:section>
      </div>

      <div id="editorDetails">
      <f:section title="${%editor.heading}">

        <!-- Stray duplicate heading removed (found live, 2026-09-04): f:section already renders
             this same editor.heading text as its own title bar above — a second bold heading
             here was leftover from before the accordion-to-f:section conversion and is dead
             weight now that no sibling element still needs this row's flex layout. -->
        <div class="ctsync-btn-row help-sibling">
          <button type="button" id="modeEditBtn"
                 class="jenkins-button jenkins-button--primary" title="${%modeEdit.title}"
                 ><l:icon src="symbol-edit" class="icon-sm"/> ${%modeEdit.label}</button>
          <j:choose>
            <j:when test="${it.templateAvailable}">
              <button type="button" id="modeGenerateBtn"
                     class="jenkins-button" title="${%generateTemplate.title}"
                     ><l:icon src="symbol-document-text" class="icon-sm"/> ${%generateTemplate.label}</button>
            </j:when>
            <j:otherwise>
              <button type="button" id="modeGenerateBtn"
                     class="jenkins-button" disabled="disabled"
                     title="${%generateTemplate.disabledTitle}"><l:icon src="symbol-document-text" class="icon-sm"/> ${%generateTemplate.label}</button>
            </j:otherwise>
          </j:choose>
          <f:helpLink url="/job-config-chain-help/commonEditor" featureName="${%editor.heading}"/>
        </div>
        <f:helpArea/>

        <!-- Content-type picker (see multi-format-content.md's "Content type model" section) — its own row directly below the mode-toggle row and
             directly above the Monaco box, per the wireframe. Enabled only while this Config Set does
             not exist yet (it.exists == false); becomes a disabled/read-only display of the committed
             value the moment a first version exists. CSP migration: per-radio onclick removed — a
             single index.js listener on input[name=contentTypeRadio] (any of these three) reads
             this.value, exactly mirroring the three separate handlers it replaces. -->
        <div class="ctsync-content-type-row" id="contentTypeRow">
          <span class="help-sibling ctsync-help-row">
          <label class="ctsync-content-type-label">${%contentType.label}</label>
          <f:helpLink url="/job-config-chain-help/contentType" featureName="${%contentType.label}"/>
        </span>
          <j:choose>
            <j:when test="${it.contentTypeLocked}">
              <span class="ctsync-icon-text" id="contentTypeLockedDisplay">${it.contentTypeValue}<l:icon src="symbol-lock-closed" class="icon-sm"/> ${%contentType.locked}</span>
            </j:when>
            <j:otherwise>
              <!-- Pre-selects whichever radio matches getPreselectedContentTypeValue() (see
                   multi-format-content.md's "'Choose content type at creation' moved earlier in the
                   flow" section)
                   (normally JSON by default, or the type carried over from the root list page's own
                   picker via ?contentType=...) instead of always hard-defaulting to JSON. Written as
                   an explicit j:choose per radio (rather than a computed "checked" attribute value)
                   to avoid relying on Jelly's boolean-attribute-omission behavior for a plain HTML
                   &lt;input&gt; element, matching this file's own existing j:choose/j:when convention
                   (see the Activate-button branch above). -->
              <j:set var="preselectedContentType" value="${it.preselectedContentTypeValue}"/>
              <span id="contentTypeUnlockedGroup">
                <!-- Hint-before-radios order (owner-directed consistency pass, 2026-09-04): the
                     root list page's own New Config Set picker was redesigned to read
                     label -> hint -> radios (a decision reached first, then reused here) instead
                     of radios -> trailing hint, since a trailing hint reads as a squeezed-in
                     afterthought rather than something read before making the choice. -->
                <span class="ctsync-content-type-hint"><l:icon src="symbol-information-circle" class="icon-sm"/> ${%contentType.chooseOnceHelp}</span>
                <label class="ctsync-radio-label">
                  <j:choose>
                    <j:when test="${preselectedContentType == 'JSON'}">
                      <input type="radio" name="contentTypeRadio" value="JSON" checked="checked"/>
                    </j:when>
                    <j:otherwise>
                      <input type="radio" name="contentTypeRadio" value="JSON"/>
                    </j:otherwise>
                  </j:choose>
                  JSON</label>
                <label class="ctsync-radio-label">
                  <j:choose>
                    <j:when test="${preselectedContentType == 'XML'}">
                      <input type="radio" name="contentTypeRadio" value="XML" checked="checked"/>
                    </j:when>
                    <j:otherwise>
                      <input type="radio" name="contentTypeRadio" value="XML"/>
                    </j:otherwise>
                  </j:choose>
                  XML</label>
                <label class="ctsync-radio-label">
                  <j:choose>
                    <j:when test="${preselectedContentType == 'YAML'}">
                      <input type="radio" name="contentTypeRadio" value="YAML" checked="checked"/>
                    </j:when>
                    <j:otherwise>
                      <input type="radio" name="contentTypeRadio" value="YAML"/>
                    </j:otherwise>
                  </j:choose>
                  YAML</label>
              </span>
            </j:otherwise>
          </j:choose>
          <span id="checkingIndicator" class="ctsync-muted ctsync-icon-text ctsync-hidden"><l:icon src="symbol-hourglass" class="icon-sm"/> ${%checking.yaml}</span>
          <f:helpArea/>
        </div>

        <div id="compareBanner" class="jenkins-alert jenkins-alert-info ctsync-banner-row ctsync-hidden">
          <span id="compareBannerText"/>
          <span>
            <button type="button" id="loadComparedBtn" class="jenkins-button jenkins-button--primary"
                   title="${%loadIntoEditor.title}"
                   >${%loadIntoEditor.label}</button>
            <button type="button" id="backToEditingBtn" class="jenkins-button"
                   title="${%backToEditing.title}"
                   >${%backToEditing.label}</button>
          </span>
        </div>
        <div id="generateBanner" class="jenkins-alert jenkins-alert-info ctsync-hidden">
          ${%generateBanner.text}
        </div>
        <div id="monacoEditor" class="ctsync-editor-frame ctsync-editor-frame--tall ctsync-spaced"/>
        <div id="generateCopyRow" class="ctsync-btn-row ctsync-spaced ctsync-hidden">
          <button type="button" id="copyTemplateBtn" class="jenkins-button"
                  title="${%copyTemplate.title}"
                  ><l:icon src="symbol-duplicate" class="icon-sm"/> ${%copyTemplate.label}</button>
        </div>

        <!-- No longer a &lt;form&gt; (2026-09-02 in-place-update pass): Save/Save &amp; Activate now
             call proxy.save(...) directly from saveClicked() below — content comes straight from the
             live Monaco editor, never a hidden textarea; there is no native submit to prepare. The
             note input and contentType field remain plain elements JS reads by id.
             Spacing fix (owner report, 2026-09-11): margin-bottom above (on #monacoEditor and
             #generateCopyRow, whichever is visible) creates breathing room before this field
             instead of it sitting flush against the coding block. -->
        <f:entry title="${%changeNote.entryTitle}"
                 help="/job-config-chain-help/changeNote">
          <input class="jenkins-input" type="text" id="noteField" required="required"/>
        </f:entry>
        <input type="hidden" id="contentTypeField" value="${it.preselectedContentTypeValue}"/>

        <!-- Bottom-of-form position (owner request, 2026-09-02 UI reorg): Save/Save &amp; Activate
             relocated below the change-note field — the natural end-of-form position — instead of
             sitting inline with the "Editor" section heading. -->
        <div class="ctsync-btn-row">
          <button type="button" id="saveBtn" class="jenkins-button jenkins-button--primary"
                  title="${%save.title}">${%save.label}</button>
          <button type="button" id="saveActivateBtn"
                  class="jenkins-button"
                  title="${%saveActivate.title}">${%saveActivate.label}</button>
        </div>
      </f:section>
      </div>

      <!-- HTML5 parsing note: <script> is never a void element - a self-closed <script .../>
           is NOT closed by a real browser's HTML parser, which instead keeps consuming markup
           as this element's (unexecuted, since src is set) text content until it finds the next
           literal </script> anywhere later in the document, silently swallowing whatever real
           HTML sits in between. Every script tag here must have an explicit closing tag. -->
      <script src="${rootURL}/plugin/${it.pluginShortName}/monaco/vs/loader.js"></script>
      <link rel="stylesheet" href="${rootURL}/plugin/${it.pluginShortName}/monaco/vs/editor/editor.main.css"/>
      <st:adjunct includes="io.jenkins.plugins.jobconfigchain.adjuncts.ctsyncCommonScript"/>

      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
