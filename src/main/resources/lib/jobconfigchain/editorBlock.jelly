<?jelly escape-by-default='true'?>
<!--
  Block 4 of 4: Merged bases / Own override / Merged result. Shared between
  EnvConfigSetPage/index.jelly and ConfigTemplatesJobAction/index.jelly (tech-lead design contract,
  2026-09-09). Relies on ${it} exposing: templateAvailable, contentTypeLocked, contentTypeValue,
  ownScopeLabel (Bug 6.2 fix, 2026-09-10 — "job" on ConfigTemplatesJobAction, "layer" on
  EnvConfigSetPage; see each host's own getter javadoc).
  Every id/function referenced here (overrideEditor, mergedEditor, mergedBasesEditor,
  generatedTemplateEditor, showGeneratedTemplateView, backTo3PanelView, copyGeneratedTemplate,
  switchToEditMode, onContentTypeChange, saveClicked, discardAllChangesClicked,
  loadComparedIntoEditor) must be defined by BOTH hosts' own page-level <script> — the Monaco
  wiring and the doComputeMerge/jsPreviewMerge call shape genuinely differ between the two hosts
  (EnvConfigSetPage's explicitlyStandalone branch (see base-chains.md) vs. ConfigTemplatesJobAction's simpler
  empty-chain-resolves-to-{} contract), so the script itself is NOT shared, only this markup shell.

  CSP migration (see https://www.jenkins.io/doc/developer/security/csp/): every onclick="..."
  that used to live on this markup is removed — the sole current consumer, ConfigTemplatesJobAction,
  wires all of it in its own external index.js by id (generateTemplateBtn, backTo3PanelBtn,
  copyTemplateBtn, loadComparedBtn, backToEditingBtn, modeEditBtn, saveBtn, saveActivateBtn,
  discardAllBtn) or by `input[name=contentTypeRadio]` selector, exactly mirroring the removed
  inline handlers.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form" xmlns:l="/lib/layout">
  <j:choose>
    <j:when test="${it.ownScopeLabel == 'job'}"><j:set var="scopeNoun" value="${%scope.job}"/></j:when>
    <j:otherwise><j:set var="scopeNoun" value="${%scope.layer}"/></j:otherwise>
  </j:choose>
  <div id="editorDetails">
  <!-- Header row (owner report, 2026-09-14): f:section's own title markup (lib/form/section.jelly,
       Jenkins core) renders the title as its own sibling <div class="jenkins-section__title">,
       separate from this block's body, so a section title and a body-level button row could never
       land on the same horizontal line through f:section alone. Replaced f:section here with its
       exact underlying markup (<section class="jenkins-section"> + a title div) reproduced by hand,
       so the title text and the Generate-Template/Back buttons can share ONE flex row
       (space-between: title left edge, buttons right edge) while every other visual contract
       f:section provided (the "jenkins-section"/"jenkins-section__title" CSS classes, hence spacing/
       typography) is preserved unchanged. f:rowSet (also inside f:section) is a documented no-op
       here since no @name/@ref is passed, so dropping it changes nothing. -->
  <section class="jenkins-section">
    <div class="jenkins-section__title ctsync-section-title-row help-sibling">
      <span>${%editor.heading}</span>
      <!-- Always enabled (owner requirement, 2026-09-12): "Generate Template" now generates from the
           caller's CURRENT, possibly-unsaved override/base-chain draft (see showGeneratedTemplateView()
           in each host's own <script>), so there is no "nothing to template yet" state that would
           justify disabling this button — even a brand-new, never-saved page has SOME draft to
           template (an empty override against an empty/default base chain). The old
           ${it.templateAvailable}-gated disabled branch is removed; templateAvailable is kept on both
           hosts purely so this button's Jelly-visible contract stays mirrored across
           ConfigTemplatesJobAction/EnvConfigSetPage. -->
      <div class="ctsync-btn-row ctsync-btn-row--flush">
        <button type="button" id="generateTemplateBtn" class="jenkins-button"
               title="${%generateTemplate.title(scopeNoun)}"
               ><l:icon src="symbol-document-text" class="icon-sm"/> ${%generateTemplate.label}</button>
        <button type="button" id="backTo3PanelBtn" class="jenkins-button ctsync-hidden"
               title="${%backTo3Panel.title}"
               ><l:icon src="symbol-arrow-left" class="icon-sm"/> ${%backTo3Panel.label}</button>
        <f:helpLink url="/job-config-chain-help/generateTemplate" featureName="${%generateTemplate.label}"/>
      </div>
    </div>
    <f:helpArea/>

    <div id="generateBanner" class="jenkins-alert jenkins-alert-info ctsync-hidden">
      ${%generateBanner.text(scopeNoun)}
    </div>

    <div id="generatedTemplatePanel" class="ctsync-generated-panel ctsync-hidden">
      <h3>${%generated.heading}</h3>
      <div id="generatedTemplateEditor" class="ctsync-editor-frame ctsync-editor-frame--tall"/>
      <div class="ctsync-btn-row">
        <button type="button" id="copyTemplateBtn" class="jenkins-button"
                title="${%copyTemplate.title}"
                ><l:icon src="symbol-duplicate" class="icon-sm"/> ${%copyTemplate.label}</button>
      </div>
    </div>

    <!-- Spacing fix (owner report, 2026-09-11): the "Change note (required)" field sat flush
         against the coding block above it with no breathing room — margin-bottom on the editor
         grid itself (rather than margin-top on the f:entry, which f:entry doesn't expose a hook
         for) reliably creates the gap regardless of which layout (table-row vs. div-based) this
         Jenkins baseline renders f:entry as. -->
    <div id="mergeLayout" class="ctsync-merge-grid">
      <!-- Compare-mode banner must render OUTSIDE/ABOVE .ctsync-merge-top (full width, sibling of
           the grid, not nested inside #envOverridePane) — same convention as #generateBanner above.
           Nesting it inside one column only pushed that column's title down and unbalanced the
           two-column layout relative to "Merged bases" (business-rules/base-chains.md, "Merge-panel
           header alignment & compare-mode banner placement", 2026-09-11). -->
      <div id="compareBanner" class="jenkins-alert jenkins-alert-info ctsync-banner-row ctsync-hidden">
        <span id="compareBannerText"/>
        <span>
          <button type="button" id="loadComparedBtn" class="jenkins-button jenkins-button--primary"
                 title="${%loadIntoEditor.title}"
                 >${%loadIntoEditor.label}</button>
          <button type="button" id="backToEditingBtn" class="jenkins-button"
                 title="${%backToEditing.title}"
                 >${%backToEditing.label}</button>
        </span>
      </div>

      <!-- Content-type picker row (BUG-14 regression fix, 2026-09-12): must render OUTSIDE/ABOVE
           .ctsync-merge-top (full width, sibling of the grid, same convention as #compareBanner and
           #generateBanner above) — NOT nested inside #envOverridePane. Nesting it inside one column
           only pushed that column's editor down relative to "Merged bases"'s editor, unbalancing the
           two-column layout on any Config Set whose content type isn't locked yet (fresh/unsaved env
           or job override). Visible ONLY while there is no chain-resolved type to follow
           (EnvConfigSetPage: explicitlyStandalone with zero rows; ConfigTemplatesJobAction:
           simply an empty base chain — no checkbox concept there). Each host's own script drives
           this row's visibility by id ("contentTypeRow"); moving its DOM position does not affect
           that lookup. The locked/unlocked markup itself (${it.contentTypeLocked}) is identical on
           both hosts. -->
      <div class="ctsync-content-type-row ctsync-hidden" id="contentTypeRow">
        <span class="help-sibling ctsync-help-row">
          <label class="ctsync-content-type-label">${%contentType.label}</label>
          <f:helpLink url="/job-config-chain-help/contentType" featureName="${%contentType.label}"/>
        </span>
        <j:choose>
          <j:when test="${it.contentTypeLocked}">
            <span class="ctsync-icon-text" id="contentTypeLockedDisplay">${it.contentTypeValue}<l:icon src="symbol-lock-closed" class="icon-sm"/> ${%contentType.locked}</span>
          </j:when>
          <j:otherwise>
            <span id="contentTypeUnlockedGroup">
              <span class="ctsync-content-type-hint"><l:icon src="symbol-information-circle" class="icon-sm"/> ${%contentType.chooseOnceHelp}</span>
              <label class="ctsync-radio-label"><input type="radio" name="contentTypeRadio" value="JSON" checked="checked"/> JSON</label>
              <label class="ctsync-radio-label"><input type="radio" name="contentTypeRadio" value="XML"/> XML</label>
              <label class="ctsync-radio-label"><input type="radio" name="contentTypeRadio" value="YAML"/> YAML</label>
            </span>
          </j:otherwise>
        </j:choose>
        <f:helpArea/>
      </div>

      <div class="ctsync-merge-top">
        <div class="ctsync-merge-pane" id="mergedBasesPane">
          <h3 class="help-sibling">${%mergedBases.heading}
            <f:helpLink url="/job-config-chain-help/mergedBases" featureName="${%mergedBases.heading}"/></h3>
          <f:helpArea/>
          <div id="mergedBasesEditor" class="ctsync-editor-frame"/>
        </div>
        <div class="ctsync-merge-pane" id="envOverridePane">
          <h3 class="help-sibling">${%envOverride.heading}
            <f:helpLink url="/job-config-chain-help/overrideEditor" featureName="${%envOverride.heading}"/></h3>
          <f:helpArea/>

          <!-- Save-result feedback (owner requirement, 2026-09-14): no longer an inline banner div
               here — both hosts' own saveClicked() now call window.notificationBar.show(...), the
               same native Jenkins toast used by "Apply" on /job/&lt;name&gt;/configure. -->
          <div id="overrideEditor" class="ctsync-editor-frame"/>

          <!-- Moved out of the header row (owner report, 2026-09-11): the header row must be a
               bare, title-only h3 identical in structure to "Merged bases"'s own header, so both
               editors start at the same Y offset within their columns — this control row is a new
               sibling below the editor instead, same position id/onclick, DOM position only changed
               (ID-based event wiring in each host's own <script> is unaffected). -->
          <div class="ctsync-editor-toolbar-row">
            <!-- Hidden with fewer than 2 versions (owner requirement, 2026-09-14): this button's only
                 purpose is exiting compare-mode (returning from comparing the draft against a
                 historical version back to normal editing) — with 0 or 1 version there is nothing to
                 meaningfully compare against, so the button would be pointless clutter. Initial SSR
                 render reuses the SAME ${it.versions} getter the Version-history table itself renders
                 from (versionHistoryBlock tag); the AJAX-refreshed case is handled by
                 each host's own renderVersionHistoryRows(versions) toggling this same id by the
                 versions.length passed to it (no new data source added). -->
            <button type="button" id="modeEditBtn"
                   class="jenkins-button jenkins-button--primary${it.versions.size() &lt; 2 ? ' ctsync-hidden' : ''}" title="${%modeEdit.title}"
                   ><l:icon src="symbol-edit" class="icon-sm"/> ${%modeEdit.label}</button>
            <span id="checkingIndicator" class="ctsync-muted ctsync-icon-text ctsync-hidden"><l:icon src="symbol-hourglass" class="icon-sm"/> ${%checking.yaml}</span>
          </div>
        </div>
      </div>
      <div class="ctsync-merge-pane ctsync-merge-full" id="mergedResultPane">
        <h3 class="help-sibling">${%mergedResult.heading}
          <f:helpLink url="/job-config-chain-help/mergedResult" featureName="${%mergedResult.heading}"/></h3>
        <f:helpArea/>
        <div id="mergedEditor" class="ctsync-editor-frame"/>
        <div id="mergedStaleIndicator" class="ctsync-stale ctsync-hidden">
          ${%staleIndicator.text}
        </div>
      </div>
    </div>

    <f:entry title="${%changeNote.entryTitle}"
                 help="/job-config-chain-help/changeNote">
      <input class="jenkins-input" type="text" id="noteField" required="required"/>
    </f:entry>
    <input type="hidden" id="baseChainField" value=""/>

    <div class="ctsync-btn-row">
      <button type="button" id="saveBtn" class="jenkins-button jenkins-button--primary"
              title="${%save.title}">${%save.label}</button>
      <button type="button" id="saveActivateBtn"
              class="jenkins-button"
              title="${%saveActivate.title}">${%saveActivate.label}</button>
      <button type="button" id="discardAllBtn" class="jenkins-button jenkins-button--destructive"
              title="${%discardAll.title}">${%discardAll.label}</button>
    </div>
  </section>
  </div>
</j:jelly>
